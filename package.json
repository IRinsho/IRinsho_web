{
  "name": "irinsho-site",
  "type": "module",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "sync": "node tools/sync-photos.mjs && node tools/sync-frames.mjs && node tools/sync-covers.mjs && node tools/build-blog.mjs && node tools/build-sitemap.mjs",
    "dev": "npm run sync && astro dev",
    "build": "npm run sync && astro build",
    "preview": "astro preview",
    "sync:photos": "node tools/sync-photos.mjs",
    "sync:frames": "node tools/sync-frames.mjs",
    "sync:covers": "node tools/sync-covers.mjs",
    "sync:blog": "node tools/build-blog.mjs",
    "sync:sitemap": "node tools/build-sitemap.mjs",
    "cover": "node tools/set-cover.mjs",
    "admin": "node admin/server/admin-server.mjs",
    "admin:test": "node --test admin/tests/unit.test.mjs",
    "admin:test:api": "node --test admin/tests/api.test.mjs",
    "admin:test:cloud": "node --test node-functions/_lib/cloud.test.mjs",
    "admin:test:all": "node --test admin/tests/unit.test.mjs admin/tests/api.test.mjs node-functions/_lib/cloud.test.mjs"
  },
  "dependencies": {
    "@edgeone/pages-blob": "^0.0.18"
  },
  "devDependencies": {
    "astro": "^5.0.0",
    "sharp": "^0.33.0"
  }
}
