---
/* =========================================================
 *  「最近信号」—— 首页的浅色纸面段落
 *  ---------------------------------------------------------
 *  为什么要有这一段：
 *    参考站 yuimi-chaya.github.io（Kisara）首页最大的版面手法不是动效，
 *    而是**明暗交替**：深色首屏 → 纯白纸面漫画章 → 纯黑冰柜章 →
 *    浅灰视频事件章 → 浅色 Latest notes → 深色页脚。
 *    整页是「翻过去一页印刷品、再翻回深色」的节奏。
 *    本站之前首页从头到尾是同一种深藏青，读到下半页就没有换气点。
 *
 *  这一段就是那个「换气点」：一片暖白纸，深墨字，绯红小字眉，
 *  三栏细线网格 —— 编辑部 / 印刷品的排版语言。
 *
 *  ⚠ 配色不用参考站的冷白（#ffffff / #edf1f0），而是本站自己的暖纸：
 *    --paper-ink #241a20、--paper-rose #c8395f、底色 #f7f3ee。
 *    这两个色本来就在 style.css 的 :root 里（个人页 ME 用的同一套纸），
 *    所以这一段不是「外来的皮」，是本站纸面主题在首页的延伸。
 * ======================================================= */

import { notes, coverOf } from '../lib/notes.js';
import { asset } from '../lib/url.js';
import { pad2, fmtSlash, hueFor } from '../lib/format.js';

/* 取最近三篇。
   ⚠ 这里**不能**直接用 lib/notes.js 导出的 notes —— 它为了列表页的观感
     把置顶的排到了最前面。但这一段标题是「最近信号」，
     读者期待的是「按时间最新的三篇」，置顶的旧笔记排在最新前面会显得不合理。
     所以这里自己按日期倒序排一遍（置顶与否不参与）。 */
const latest = notes
  .slice()
  .sort((a, b) => String(b.date || '').localeCompare(String(a.date || '')))
  .slice(0, 3);

/* 摘要兜底：很多笔记没写 summary，正文又是 Markdown，
   直接截 content 会露出 ``` 和 # 号。这里把 Markdown 洗成纯文本再截断。 */
function plainText(s) {
  return String(s || '')
    .replace(/```[\s\S]*?```/g, ' ')          // 代码块整块丢掉
    .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')    // 图片
    .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')  // 链接只留文字
    .replace(/`{1,3}([^`]*)`{1,3}/g, '$1')    // 行内代码
    .replace(/[#>*_|~]/g, ' ')                // Markdown 符号
    .replace(/\s+/g, ' ')
    .trim();
}

function excerptOf(n, max = 52) {
  const base = plainText(n.summary) || plainText(n.content);
  if (!base) return '';
  return base.length > max ? base.slice(0, max).trimEnd() + '…' : base;
}

const total = pad2(notes.length);
---

<section class="paper-band" id="latestSignals" aria-labelledby="latestSignalsTitle">
  {/* 纸面上的极淡网点，靠 CSS 画（零素材） */}
  <span class="paper-grain" aria-hidden="true"></span>

  <div class="paper-inner">
    <header class="paper-head">
      <p class="paper-eyebrow">RECENT TRANSMISSIONS / {total}</p>
      <h2 class="paper-title" id="latestSignalsTitle">最近信号<i>.</i></h2>
      <a class="paper-more" href={asset('notes/')}>
        <span>查看全部</span><b aria-hidden="true">↗</b>
      </a>
    </header>

    {latest.length > 0 ? (
      <div class="paper-shelf">
        {latest.map((n, i) => (
          <a
            class="paper-card"
            href={asset('notes/' + n.id + '/')}
            style={`--i:${i}`}
            data-fam={i}
          >
            {/* SYNAPSE：卡顶抬起的那条「标签页」，写分类名（参考站的品牌位）。
                KISARA 下 display:none，分类仍然由下面的 .paper-cat 承担。 */}
            <span class="paper-tab">
              <i aria-hidden="true"></i>{n.category || '未分类'}
            </span>

            <figure class="paper-cover">
              {n.cover ? (
                <img src={asset(coverOf(n.cover))} alt="" loading="lazy" decoding="async" />
              ) : (
                /* 没封面就用类目色相生成一张「印刷底」，和列表页同一套算法 */
                <span class="paper-cover-gen" style={`--h:${hueFor(n.category || n.title)}`}>
                  <b>{pad2(i + 1)}</b>
                </span>
              )}
            </figure>

            {/* 文字统一收在右列：封面独占左列，其余内容在右列里自然堆叠 */}
            <div class="paper-body">
              <p class="paper-meta">
                <span class="paper-cat">{n.category || '未分类'}</span>
                <span class="paper-slash" aria-hidden="true">/</span>
                <time datetime={n.date}>{fmtSlash(n.date)}</time>
              </p>

              <h3 class="paper-card-title">{n.pinned ? '📌 ' : ''}{n.title}</h3>

              {excerptOf(n) && <p class="paper-excerpt">{excerptOf(n)}</p>}

              <span class="paper-read">
                READ SIGNAL <i aria-hidden="true">↗</i>
              </span>
            </div>

            {/* 三颗点：位置即第几张（参考站卡底那一排） */}
            <span class="paper-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          </a>
        ))}
      </div>
    ) : (
      <p class="paper-empty">
        还没有笔记。用 Obsidian 打开 <code>blog/</code> 写一篇，然后运行 <code>npm run sync</code>。
      </p>
    )}
  </div>
</section>
