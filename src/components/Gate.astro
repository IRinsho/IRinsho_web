---
/* =========================================================
 *  首屏舞台（Gate）—— 各内页共用的一套开场效果
 *  ---------------------------------------------------------
 *  和首页那套是同一份 CSS（.gate / .gate-* 都在 style.css 里）：
 *    全屏背景 + 压暗层 + 漂浮粒子 + 鼠标视差 + 滚动推近 + 顶部进度轨
 *
 *  用法（放在页面最前面、Base 的默认插槽里）：
 *    <Gate eyebrow="GALLERY / 02" title="相册" sub="随手拍下来的光。" />
 *    <Gate … image="media/images/xxx.jpg" />   想换背景就传 image
 * ======================================================= */
import { asset } from '../lib/url.js';

const {
  eyebrow = 'CHAPTER',
  title = '',
  sub = '',
  image = 'media/images/home-hero.jpg',   // 默认用首页那张主视觉
  no = ''                                  // 右下角的编号，可选
} = Astro.props;
---

<section class="gate gate--page" data-gate style={`--hero:url(${asset(image)})`}>
  <div class="gate-bg" aria-hidden="true">
    <span class="gate-layer gate-hero"></span>
    <span class="gate-veil"></span>
  </div>

  <div class="gate-particles" aria-hidden="true">
    {[...Array(8)].map((_, i) => (
      <i
        style={`left:${(i * 12.3 + 5).toFixed(1)}%;--dx:${(i % 2 ? -1 : 1) * (10 + i * 3)}px;--dy:${52 + (i % 4) * 10}vh;--dur:${20 + (i % 5) * 3}s;--delay:${(i * 1.9).toFixed(1)}s`}
      />
    ))}
  </div>

  <div class="gate-inner">
    <p class="gate-kicker">{eyebrow}</p>
    <h1 class="gate-title">{title}</h1>
    {sub && <p class="gate-sub">{sub}</p>}
    <span class="gate-scroll" aria-hidden="true"><i></i></span>
    {no && <span class="gate-no" aria-hidden="true">{no}</span>}
  </div>
</section>

<div class="gate-rail" data-gate-rail aria-hidden="true"><i></i></div>

<script>
  /* 和首页同一套逻辑：滚动进度写 --gate-p，进度轨写 --rail，
     鼠标位置写 --mx/--my（视差）。挂 astro:page-load，换页可重复初始化。*/
  (function () {
    const reduce = window.matchMedia &&
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let raf = 0;

    function bind() {
      const gate = document.querySelector('[data-gate]');
      const rail = document.querySelector('[data-gate-rail]');
      if (!gate) return;

      // 换页返回时脚本会再跑一遍 —— 元素换了就重新绑，元素没换就别叠加监听
      if (gate.dataset.gateBound === '1') {
        update();
        return;
      }
      gate.dataset.gateBound = '1';

      if (reduce) {
        gate.style.setProperty('--gate-p', '0');
        if (rail) rail.style.opacity = '0';
        return;
      }

      window.addEventListener('mousemove', (e) => {
        const r = gate.getBoundingClientRect();
        if (r.bottom < 0 || r.top > window.innerHeight) return;
        gate.style.setProperty('--mx', (e.clientX / window.innerWidth - 0.5).toFixed(3));
        gate.style.setProperty('--my', (e.clientY / window.innerHeight - 0.5).toFixed(3));
      }, { passive: true });

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      update();
    }

    function update() {
      raf = 0;
      const gate = document.querySelector('[data-gate]');
      const rail = document.querySelector('[data-gate-rail]');
      if (!gate) return;
      const h = gate.offsetHeight || 1;
      const p = Math.min(1, Math.max(0, window.scrollY / (h * 0.85)));
      gate.style.setProperty('--gate-p', p.toFixed(3));
      if (rail) {
        const doc = document.documentElement;
        const total = Math.max(1, doc.scrollHeight - window.innerHeight);
        rail.style.setProperty('--rail', (window.scrollY / total).toFixed(4));
      }
    }

    function onScroll() {
      if (raf) return;
      raf = requestAnimationFrame(update);
    }

    document.addEventListener('astro:page-load', bind);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bind);
    } else {
      bind();
    }
  })();
</script>
