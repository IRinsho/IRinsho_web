---
/* =========================================================
 *  落地页 / 开场：粒子重组的纸页（杂志翻页 + 片头字卡）
 *  ---------------------------------------------------------
 *  流程：
 *    纸直接铺满（**不滑入** —— 之前的"从右往左滑"会露出一帧
 *      只盖住半边、字卡还半透明的中间状态，很难看）
 *    → 粒子从画面中心向外重组，字卡跟着由虚到实浮现
 *    → 停在「进入主页」按钮上
 *    → 用户点击 → 字卡炸成粒子消散 + 纸淡出 → 首屏在背后亮起来
 *
 *  为什么用"纸"：这个站是深色底，深色物体在上面"动了等于没动"
 *  （实测主视觉平均亮度只有 26/255，和页面底色 21 几乎一样）。
 *  一张暖白的纸是强反差，不依赖底图好不好看。
 *
 *  ⚠ 安全设计（硬要求，改这里之前先读一遍）：
 *    1. 纸的**基础样式就是 opacity:0 + visibility:hidden**。
 *       只有 <html> 上有 .u-opening 类（Base.astro 的内联脚本按
 *       "首页硬加载 + 允许动效"两个条件加上）时才显示。
 *       脚本没跑 / 被降级 → 纸根本不存在、页面也能正常滚动。
 *    2. 画布只是**装饰**：粒子画不出来最坏就是"字卡直接出现"，
 *       内容一个字都不会少。
 *    3. 五条强制拆除路径：进入按钮、点纸面、键盘、滚轮/触摸、
 *       切后台再回来 —— 任何一条命中都会把纸从 DOM 里删掉。
 *    4. prefers-reduced-motion：纸不出现（画布也不启动）。
 * ======================================================= */

const { name = '', subtitle = '', folio = '' } = Astro.props;
---

<div class="opening" id="paperOpening" aria-hidden="true">
  <div class="opening-fold opening-fold--left"></div>
  <div class="opening-fold opening-fold--right"></div>

  {/* 粒子层：进场时从中心向外重组出字卡，点击时炸开消散 */}
  <canvas class="opening-canvas" id="paperCanvas"></canvas>

  <div class="opening-inner" id="paperInner">
    <p class="opening-eyebrow">CHAPTER 00 / OPENING</p>
    <h1 class="opening-title">{name}</h1>
    <span class="opening-rule"></span>
    {subtitle && <p class="opening-sub">{subtitle}</p>}
    {folio && <p class="opening-foot">{folio}</p>}
    <button type="button" class="opening-enter" id="paperEnter">进入主页</button>
    <p class="opening-hint">点击任意处进入</p>
  </div>
</div>

<script>
  (function () {
    const root = document.documentElement;
    const paper = document.getElementById('paperOpening');
    const enter = document.getElementById('paperEnter');
    const canvas = document.getElementById('paperCanvas');
    const inner = document.getElementById('paperInner');

    if (!paper) return;

    /* ⚠ 条件不满足（不是首页 / 用户要求减少动效 / 已经进过一次）
       → 纸直接摘掉，并且把"防止背后滚动"的锁一并解开。
       锁是 JS 加的、纸的显示是 CSS 控制的，两边必须成对出现，
       否则会出现"纸没了但页面滚不动"。 */
    if (!root.classList.contains('u-opening')) {
      paper.remove();
      root.style.removeProperty('overflow');
      return;
    }

    let closed = false;
    let guard = 0;
    let particles = null;

    /* 消散动画时长（毫秒）。⚠ 这个数必须和画布 draw() 里 dissolve 分支的
       T 保持一致 —— 结算（撤纸 + 首屏入场）就是按它推迟的。
       改一处记得改另一处。 */
    const DISSOLVE_MS = 1450;

    /* ---------------- 粒子：聚成文字 → 呼吸 → 点击消散 ----------------
       ★ 关键改动：粒子位置是**真的从字形上采样出来的**。
         做法：拿一个离屏画布，用页面同款字体把标题画一遍，
         再 getImageData 取所有有像素的坐标当粒子的目标点。
         这样粒子聚起来就是"IRinsho"这几个字本身，而不是一圈围着
         矩形乱飘的点（那是上一版，用户说"有点太呆了"）。

       ⚠ 代价与控量：离屏画布按 dpr 缩放，采样步长 3px（窄屏 4px）——
         一次 getImageData 而已，几十毫秒内完成，而且只在开屏时做一次。
         粒子数按采样结果**均匀抽稀**到上限，避免笔画粗的地方糊成一团。 */
    function initParticles() {
      if (!canvas || !canvas.getContext) return null;
      const reduce = window.matchMedia &&
        window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce) return null;

      const ctx = canvas.getContext('2d');
      if (!ctx) return null;

      const small = window.innerWidth < 760;
      /* ⚠ 目标点数量与采样步长：粒子现在**就是文字本身**，密度必须够，
         否则笔画会被扯成一把散点（实测 3px 步长时就是这个下场）。
         2px 步长在 1440px 下采样出约 2600 个候选点，全部用上 ——
         纯 arc 填充，这个量级在桌面端是流畅的。 */
      const MAX_PARTS = small ? 1200 : 2600;
      const STEP = small ? 3 : 2;              // 采样步长（CSS 像素）
      /* ⚠ 配色：粒子**是文字**，所以绝大多数必须是深墨色，否则笔画会被
         彩点打碎、看着像噪点（实测彩色占比 2/7 时就明显读不出来）。
         现在约 12% 的粒子带色（玫瑰粉/青各半），当点缀用。 */
      const HUES = [];
      for (let i = 0; i < 100; i++) {
        if (i < 82) HUES.push('#241a20');        // 深墨（主体）
        else if (i < 90) HUES.push('#3a2b33');   // 次深
        else if (i < 95) HUES.push('#c8395f');   // 玫瑰粉点缀
        else HUES.push('#7bb6b2');               // 青点缀
      }

      let W = 0, H = 0, dpr = 1;
      let parts = [];
      let sparks = [];             // 消散时的飞溅火花（见 dissolve）
      let raf = 0;
      let phase = 'gather';        // gather → hold → dissolve
      let t0 = performance.now();
      let cx = 0, cy = 0;          // 重组中心（= 标题中心）
      let clickX = 0, clickY = 0;

      function resize() {
        const r = paper.getBoundingClientRect();
        W = Math.max(1, Math.floor(r.width));
        H = Math.max(1, Math.floor(r.height));
        dpr = Math.min(2, window.devicePixelRatio || 1);
        canvas.width = Math.floor(W * dpr);
        canvas.height = Math.floor(H * dpr);
        canvas.style.width = W + 'px';
        canvas.style.height = H + 'px';
        // 之后所有绘制都用 CSS 像素坐标，由这个变换负责放大
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }

      // 取标题元素上真正用于显示的字体（含字距），保证字形和页面一致
      function fontOf(el) {
        const cs = getComputedStyle(el);
        const size = parseFloat(cs.fontSize) || 96;
        const style = cs.fontStyle && cs.fontStyle !== 'normal' ? cs.fontStyle + ' ' : '';
        const weight = cs.fontWeight || '400';
        const weightNum = parseInt(weight, 10);
        const w = isNaN(weightNum) ? weight : (weightNum >= 600 ? '700' : '400');
        return style + w + ' ' + size + 'px ' + (cs.fontFamily || 'serif');
      }

      /* 采样字形 → 目标点数组（CSS 像素坐标） */
      function sampleGlyphs() {
        const titleEl = document.querySelector('.opening-title');
        if (!titleEl || !titleEl.textContent.trim()) return null;

        const r = titleEl.getBoundingClientRect();
        if (!r.width || !r.height) return null;

        const pad = 10;
        const ox = r.left - pad;
        const oy = r.top - pad;
        const w = Math.ceil(r.width + pad * 2);
        const h = Math.ceil(r.height + pad * 2);

        const off = document.createElement('canvas');
        off.width = Math.ceil(w * dpr);
        off.height = Math.ceil(h * dpr);
        const octx = off.getContext('2d');
        if (!octx) return null;
        octx.setTransform(dpr, 0, 0, dpr, 0, 0);

        const font = fontOf(titleEl);
        octx.font = font;
        octx.fillStyle = '#000';
        octx.textBaseline = 'alphabetic';

        const text = titleEl.textContent.trim();
        const m = octx.measureText(text);
        const size = parseFloat(getComputedStyle(titleEl).fontSize) || 96;
        const asc = m.actualBoundingBoxAscent || size * .75;
        const desc = m.actualBoundingBoxDescent || size * .25;
        // 文字在元素里的位置：letter-spacing 会在右侧多留一点，
        // 用测量宽度把起点居中，和 CSS 的 text-indent 补偿对应
        const startX = pad + Math.max(0, (w - pad * 2 - m.width) / 2);
        const baseY = pad + (h - pad * 2 - (asc + desc)) / 2 + asc;
        octx.fillText(text, startX, baseY);

        let data;
        try {
          data = octx.getImageData(0, 0, off.width, off.height).data;
        } catch (e) { return null; }        // 理论上不会发生（同源画布）

        const pts = [];
        const stepDev = Math.max(1, Math.round(STEP * dpr));
        for (let y = 0; y < off.height; y += stepDev) {
          for (let x = 0; x < off.width; x += stepDev) {
            if (data[(y * off.width + x) * 4 + 3] > 90) {
              // 转回 CSS 像素并加一点点抖动，避免出现整齐的网格感
              pts.push([
                ox + x / dpr + (Math.random() - .5) * 1.1,
                oy + y / dpr + (Math.random() - .5) * 1.1
              ]);
            }
          }
        }
        if (!pts.length) return null;

        /* ★ 对齐：把采样点的包围盒中心，搬到标题元素矩形的中心。
           为什么不用 measureText 的 ascent/descent：那套度量和实际字形框
           有偏差（衬线字的上下留白不对称），照它算出来的粒子会整体偏下 ——
           实测粒子框是 [504,316,430,116]，标题是 [454,306,533,108]，
           肉眼就是"字和粒子错开一层"。
           用采样点自己的包围盒来对齐，就不依赖任何字体度量了。 */
        let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
        for (const p of pts) {
          if (p[0] < minX) minX = p[0];
          if (p[0] > maxX) maxX = p[0];
          if (p[1] < minY) minY = p[1];
          if (p[1] > maxY) maxY = p[1];
        }
        const dx = (r.left + r.width / 2) - (minX + maxX) / 2;
        const dy = (r.top + r.height / 2) - (minY + maxY) / 2;
        for (const p of pts) { p[0] += dx; p[1] += dy; }

        // 均匀抽稀：按固定间隔取，保证首尾与整体分布都不偏
        if (pts.length > MAX_PARTS) {
          const keep = [];
          const stride = pts.length / MAX_PARTS;
          for (let i = 0; i < MAX_PARTS; i++) keep.push(pts[Math.floor(i * stride)]);
          return keep;
        }
        return pts;
      }

      function seed() {
        const targets = sampleGlyphs();

        /* ⚠ 采到字形 → 给 <html> 打上标记：CSS 据此把真实标题的 opacity
           归零。因为粒子现在**就是**文字，文字层还画着的话，看到的永远是
           "粒子飞向文字"而不是"粒子变成文字"。
           采不到字形时不加标记 —— 那样文字照常显示，最坏也只是没有粒子。 */
        if (targets && targets.length) root.classList.add('u-particle-title');
        else root.classList.remove('u-particle-title');

        // 采不到字形（字体没就绪 / 元素不可见）就退回"围绕标题矩形"的旧做法，
        // 保证任何情况下都有东西可看，不会白屏
        let pts = targets;
        if (!pts) {
          const r = inner ? inner.getBoundingClientRect()
            : { left: W * .3, top: H * .4, width: W * .4, height: H * .2 };
          pts = [];
          const n = small ? 200 : 380;
          for (let i = 0; i < n; i++) {
            pts.push([
              r.left + Math.random() * r.width,
              r.top + Math.random() * r.height
            ]);
          }
        }

        // 重组中心 = 所有目标点的重心
        let sx = 0, sy = 0;
        for (const p of pts) { sx += p[0]; sy += p[1]; }
        cx = sx / pts.length;
        cy = sy / pts.length;

        parts = pts.map((p) => {
          const a = Math.random() * Math.PI * 2;
          const d = 10 + Math.random() * 70;
          return {
            tx: p[0], ty: p[1],
            sx: cx + Math.cos(a) * d,
            sy: cy + Math.sin(a) * d,
            x: 0, y: 0, vx: 0, vy: 0,
            /* 半径要盖过采样间距（2px）：1.05~2.35px 的实心点 + 光晕，
               相邻点才会连成笔画。小了就成筛子。 */
            r: 1.05 + Math.random() * 1.3,
            color: HUES[(Math.random() * HUES.length) | 0],
            d: Math.random() * .3,          // 聚拢进度错开
            a: .9,
            /* 呼吸：三个独立相位 —— 位置抖动、大小、透明度各一条正弦，
               互相不同步，所以整片字看上去是"活的"而不是整体缩放。
               幅度都很小：这是"呼吸"，不是"飘散"。 */
            ph: Math.random() * Math.PI * 2,
            sp: .8 + Math.random() * 1.7,
            wr: .3 + Math.random() * .8,    // 位置抖动幅度（px）
            /* 离队循环：每颗粒子隔一段时间短暂飞出去再归位。
               ⚠ 幅度必须远小于笔画宽度：2~6px。之前给到 4~14px，
                 相对 3px 的点间距太大，笔画直接被扯成散点、字就读不出来。 */
            ph2: Math.random(),             // 0~1，循环相位
            sp2: .06 + Math.random() * .1,
            amp: 2 + Math.random() * 4       // 离队距离（px）
          };
        });
      }

      function ease(x) { return 1 - Math.pow(1 - x, 3); }

      /* 爆点：点击位置炸开的一圈冲击波 + 一次闪白。
         没有它的时候，粒子只是"开始往外飘"，完全不像爆炸。 */
      const wave = { on: false, x: 0, y: 0, p: 0, flash: 0 };

      function draw(now) {
        raf = 0;
        const el = now - t0;

        if (phase === 'gather') {
          const T = 1000;   // 聚拢总时长：别拖太久，用户是来进主页的不是来看动画的
          const p = Math.min(1, el / T);
          ctx.clearRect(0, 0, W, H);
          for (const q of parts) {
            const k = ease(Math.max(0, Math.min(1, (p - q.d) / (1 - q.d))));
            q.x = q.sx + (q.tx - q.sx) * k;
            q.y = q.sy + (q.ty - q.sy) * k;
            // 飞行途中更亮、落位后沉下来
            q.a = .28 + .62 * (1 - Math.abs(k - .55) / .55);
            ctx.globalAlpha = Math.max(0, Math.min(.95, q.a));
            ctx.fillStyle = q.color;
            ctx.beginPath();
            ctx.arc(q.x, q.y, q.r * (1.5 - k * .5), 0, Math.PI * 2);
            ctx.fill();
          }
          ctx.globalAlpha = 1;
          if (p >= 1) { phase = 'hold'; t0 = now; }
          raf = requestAnimationFrame(draw);
          return;
        }

        if (phase === 'hold') {
          /* ★ 停滞态：字是"活的"。三种运动叠在一起，各自的相位都随机：
               ① 呼吸：半径与透明度各走一条正弦（不同步）
               ② 微抖：位置在自己的字形点上抖 0.5~2px
               ③ 离队：每颗粒子按自己的节奏短暂飞出去再归位，
                  归位相位随机 —— 所以任何一帧都有几颗飘在外面，
                  但整体字形始终清清楚楚。
             这三条一起，才是"有呼吸感、不僵硬"。 */
          const t = el / 1000;
          ctx.clearRect(0, 0, W, H);
          for (const q of parts) {
            const br = Math.sin(t * q.sp + q.ph);

            // ③ 离队循环：0~1 的锯齿波，取其中一小段做成"飞出去再回来"
            let cyc = (t * q.sp2 + q.ph2) % 1;
            let out = 0;
            if (cyc < .5) {
              const k = cyc / .5;                 // 0→1
              out = Math.sin(k * Math.PI);        // 出去再回来的钟形
            }
            const oa = q.ph * 1.7;                // 离队方向也各自不同
            const ox = Math.cos(oa) * q.amp * out;
            const oy = Math.sin(oa) * q.amp * out;

            // ② 微抖
            const jx = Math.cos(t * .9 * q.sp + q.ph) * q.wr;
            const jy = Math.sin(t * 1.1 * q.sp + q.ph) * q.wr;

            const x = q.tx + ox + jx;
            const y = q.ty + oy + jy;
            const rad = q.r * (1 + br * .12);

            /* ⚠ 不透明度按"文字"来定，不按"装饰"来定。
               原先 0.52 上下浮动（.10~.85）是当星尘用的，笔画读不出来；
               现在下限 .78、上限 1，点才是字的墨。
               离队时只轻微减淡（-.1），不再像之前那样掉到 .5 —— 那会让
               正在"呼吸"的那几笔消失，字看着就是缺的。 */
            const al = Math.max(.78, Math.min(1, .94 + br * .06 - out * .1));
            ctx.globalAlpha = al;
            ctx.fillStyle = q.color;
            ctx.beginPath();
            ctx.arc(x, y, Math.max(.6, rad), 0, Math.PI * 2);
            ctx.fill();
            // 光晕：让相邻点的边缘连起来 —— 这是"一堆点"能看成"笔画"的关键
            ctx.globalAlpha = al * .3;
            ctx.beginPath();
            ctx.arc(x, y, Math.max(.8, rad * 1.75), 0, Math.PI * 2);
            ctx.fill();
          }
          ctx.globalAlpha = 1;
          raf = requestAnimationFrame(draw);
          return;
        }

        if (phase === 'dissolve') {
          const T = DISSOLVE_MS;        // 与 release 里的结算时间绑定
          const p = Math.min(1, el / T);
          ctx.clearRect(0, 0, W, H);

          // ③ 粒子：加速冲出去 + 先变亮变大再淡掉
          for (const q of parts) {
            q.x += q.vx;
            q.y += q.vy;
            q.vy += .085;               // 很轻的重力，让散开有重量感
            q.vx *= .988;
            q.vy *= .988;

            /* 透明度曲线：前 25% 保持接近全亮（"炸"的那一下要看得见），
               之后才淡出。第一版是线性淡出，粒子刚飞出去就透明了。 */
            const fade = p < .25 ? 1 : 1 - ease((p - .25) / .75);
            q.a = Math.max(0, fade);
            if (q.a <= .02) continue;

            ctx.globalAlpha = Math.min(1, q.a);
            ctx.fillStyle = q.color;
            const rad = q.r * (1 + p * 1.4);       // 越飞越大
            ctx.beginPath();
            ctx.arc(q.x, q.y, rad, 0, Math.PI * 2);
            ctx.fill();
          }
          ctx.globalAlpha = 1;

          // ④ 飞溅火花：比字形粒子更快更远，负责"炸"的观感
          for (const s of sparks) {
            s.x += s.vx;
            s.y += s.vy;
            s.vy += .14;
            s.vx *= .972;
            s.vy *= .972;
            const fade = p < .18 ? 1 : 1 - ease((p - .18) / .82);
            s.a = Math.max(0, fade);
            if (s.a <= .03) continue;
            ctx.globalAlpha = Math.min(1, s.a);
            ctx.fillStyle = s.color;
            ctx.beginPath();
            ctx.arc(s.x, s.y, s.r * (1 + p * 1.2), 0, Math.PI * 2);
            ctx.fill();
          }
          ctx.globalAlpha = 1;

          // ② 冲击波圆环（两圈：细的快的 + 粗的慢的，比一圈更有"爆"的感觉）
          if (wave.on) {
            wave.p += .05;
            if (wave.p >= 1) { wave.on = false; }
            else {
              const e = ease(wave.p);
              ctx.strokeStyle = '#c8395f';
              ctx.globalAlpha = Math.max(0, .6 * (1 - wave.p));
              ctx.lineWidth = 3 * (1 - wave.p) + .5;
              ctx.beginPath();
              ctx.arc(wave.x, wave.y, 6 + e * 320, 0, Math.PI * 2);
              ctx.stroke();
              ctx.globalAlpha = Math.max(0, .3 * (1 - wave.p));
              ctx.lineWidth = 1.2;
              ctx.beginPath();
              ctx.arc(wave.x, wave.y, 6 + e * 200, 0, Math.PI * 2);
              ctx.stroke();
              ctx.globalAlpha = 1;
            }
          }

          // ① 爆点闪白：第一帧最亮，0.16s 内消散
          if (wave.flash > 0) {
            wave.flash -= .045;
            if (wave.flash > 0) {
              const g = ctx.createRadialGradient(wave.x, wave.y, 0, wave.x, wave.y, 46);
              g.addColorStop(0, 'rgba(255,255,255,' + (.85 * wave.flash) + ')');
              g.addColorStop(1, 'rgba(255,255,255,0)');
              ctx.fillStyle = g;
              ctx.beginPath();
              ctx.arc(wave.x, wave.y, 46, 0, Math.PI * 2);
              ctx.fill();
            }
          }

          if (p >= 1 && !wave.on && wave.flash <= 0) { ctx.clearRect(0, 0, W, H); return; }
          raf = requestAnimationFrame(draw);
          return;
        }
      }

      function start() {
        resize();
        seed();
        phase = 'gather';
        t0 = performance.now();
        if (!raf) raf = requestAnimationFrame(draw);
      }

      /* ★ 消散 = 四个东西叠起来，缺一个都会"看不出消散"：
           ① 爆点闪白（0.16s）—— 给眼睛一个"炸了"的信号
           ② 冲击波圆环（从点击点扩到 320px 再淡出）
           ③ 粒子沿"从点击点向外"的方向**加速**冲出去
           ④ 外加一圈"飞溅"火花：比字形粒子更快更远更亮

         ⚠ 为什么要④：粒子都排在字形上，也就是排成**一条横线**。
           只让它们沿"从点击点向外"飞，方向基本也在这条线上 ——
           视觉上像"字被拉宽"，不像"炸开"。所以额外撒一圈各方向的火花，
           再给字形粒子加一点垂直于连线方向的随机速度。 */
      function dissolve(x, y) {
        if (phase === 'dissolve') return;
        clickX = x; clickY = y;
        wave.on = true; wave.x = x; wave.y = y; wave.p = 0; wave.flash = 1;

        for (const q of parts) {
          /* 粒子当前可能还在呼吸漂移的偏移位置上，
             所以先按"落位点"把它摆回来，再统一给一个向外的速度。 */
          q.x = q.tx; q.y = q.ty;

          const dx = q.tx - x;
          const dy = q.ty - y;
          const dist = Math.hypot(dx, dy) || 1;
          const nx = dx / dist;
          const ny = dy / dist;
          // 离爆点越近冲得越快（1.2 倍里再叠一层随机，避免整齐划一）
          const boost = 1 + Math.max(0, 1 - dist / 420) * 2.8;
          const f = (4.2 + Math.random() * 7.5) * boost;
          // 垂直于连线方向的散开：让"一条线上的字"能真正炸成一个圆
          const perp = (Math.random() - .5) * f * .9;
          q.vx = nx * f - ny * perp;
          q.vy = ny * f + nx * perp - (1.6 + Math.random() * 3.4);
          q.a = 1;
        }

        // ④ 飞溅火花：各方向都有，负责"炸"的观感
        const n = small ? 46 : 84;
        sparks = [];
        for (let i = 0; i < n; i++) {
          const a = (Math.PI * 2 * i) / n + Math.random() * .4;
          const sp = 5 + Math.random() * 13;
          sparks.push({
            x, y,
            vx: Math.cos(a) * sp,
            vy: Math.sin(a) * sp - 1.5,
            r: .9 + Math.random() * 1.8,
            a: 1,
            color: Math.random() < .5 ? '#c8395f' : (Math.random() < .5 ? '#241a20' : '#7bb6b2')
          });
        }

        phase = 'dissolve';
        t0 = performance.now();
        if (!raf) raf = requestAnimationFrame(draw);
      }

      window.addEventListener('resize', () => {
        resize(); seed();
        if (phase === 'hold') t0 = performance.now();
      }, { passive: true });

      start();
      /* 调试出口：只读地暴露粒子统计，便于用无头浏览器核对
         "到底生成了多少粒子、都多大、透明度多少"。
         它不参与任何渲染逻辑，删掉也不影响效果。 */
      return {
        dissolve,
        debug: () => ({
          count: parts.length,
          phase,
          sample: parts.slice(0, 6).map((q) => ({ x: Math.round(q.tx), y: Math.round(q.ty), r: +q.r.toFixed(2), c: q.color }))
        })
      };
    }

    /* ---------------- 进入 ----------------
       ⚠⚠ 这里曾经有个把整个效果毁掉的顺序错误，务必别再犯：

         原写法一上来就 `root.classList.remove('u-opening')`，而纸的显示
         （opacity / visibility）**全靠这个类撑着**（基础样式是隐藏的）。
         所以点击那一瞬间纸就被隐藏了 —— 粒子其实还在画，但它跟着纸
         一起消失，用户看到的就是"直接进主页"，完全没有消散。

         正确顺序：先让粒子把字炸开（纸保持可见、当画布），
         等动画放完再"结算"——撤纸、首屏入场、解开滚动。 */
    function finishEnter() {
      if (root.dataset.enteredFinished === '1') return;
      root.dataset.enteredFinished = '1';
      root.classList.remove('u-opening');       // 撤纸（此时它已经空了）
      root.style.removeProperty('overflow');    // 解开滚动锁
      /* ⚠ 这个类才是"首屏入场"的发令枪（见 style.css 里所有 html.u-entered 规则）。
         放在最后加：纸没了的同一刻首屏才开始亮，顺序才对。 */
      root.classList.add('u-entered');
      if (paper.isConnected) paper.remove();
      root.dataset.openingDone = '1';
      particles = null;
    }

    function release(ev) {
      if (closed) return;
      closed = true;

      // 点击点：粒子从这个位置炸开；键盘进入就用字卡中心
      let px = window.innerWidth / 2;
      let py = window.innerHeight / 2;
      if (ev && typeof ev.clientX === 'number' && ev.clientX) {
        px = ev.clientX; py = ev.clientY;
      } else if (inner) {
        const r = inner.getBoundingClientRect();
        px = r.left + r.width / 2;
        py = r.top + r.height / 2;
      }

      /* 会话记忆：进入过一次就写 cookie（会话级，关掉浏览器就没了）。
         ⚠ 这是"刷新不再重播开场"的**唯一**依据 —— 服务器读它来决定
         <html> 上是 u-opening 还是不留类。比 sessionStorage 可靠：
         服务器在首字节就能知道，不用等脚本跑。 */
      try {
        document.cookie = 'irinsho_entered=1; path=/; SameSite=Lax';
        sessionStorage.setItem('irinsho:entered', '1');   // 兜底（cookie 被禁时）
      } catch (e) { /* 隐私模式下可能失败，不影响本次进入 */ }

      window.clearTimeout(guard);
      document.removeEventListener('keydown', onKey);
      document.removeEventListener('visibilitychange', onHide);

      /* 纸与画布留在原地当"爆炸的舞台"。
         is-leaving 只把底下的字卡（eyebrow/副标题/按钮…）散掉，
         纸本身**保持完全不透明**，直到粒子放完（见 CSS）。 */
      paper.classList.add('is-leaving');

      if (particles) particles.dissolve(px, py);   // 文字炸成粒子

      /* 结算：晚一点再撤纸。晚多久 = 消散动画的时长，
         两者由这个常量绑定，改一处就够。 */
      window.setTimeout(finishEnter, DISSOLVE_MS + 60);
    }

    function onKey(e) {
      if (e.key === 'Enter' || e.key === ' ' || e.key === 'Spacebar' || e.key === 'Escape') {
        e.preventDefault();
        release();
      }
    }

    function onHide() {
      if (document.hidden && !closed) {
        release();
        window.setTimeout(() => { if (paper.isConnected) paper.remove(); }, 900);
      }
    }

    /* ---------------- 入口 ---------------- */
    if (enter) enter.addEventListener('click', release);
    paper.addEventListener('click', (e) => {
      if (e.target.closest && e.target.closest('a')) return;   // 防御性写法
      release(e);
    });
    document.addEventListener('keydown', onKey);
    paper.addEventListener('wheel', release, { passive: true });
    paper.addEventListener('touchstart', release, { passive: true });
    document.addEventListener('visibilitychange', onHide);

    /* 纸淡出结束 → 从 DOM 里移除（动画被降级时靠兜底定时器） */
    paper.addEventListener('animationend', (e) => {
      if (e.animationName === 'openingPaperAway') {
        paper.remove();
        root.dataset.openingDone = '1';
        particles = null;
      }
    });
    guard = window.setTimeout(() => {
      if (paper.isConnected) {
        paper.remove();
        root.dataset.openingDone = '1';
      }
    }, 120000);

    // 开场期间锁住背后页面的滚动（纸本身 fixed，不受影响）
    root.style.overflow = 'hidden';

    // 粒子最后启动：先让布局稳定，量出来的标题矩形才是准的
    requestAnimationFrame(() => {
      particles = initParticles();
      /* 调试钩子：只读，方便无头浏览器核对粒子统计。
         window.__paperParts?.debug() —— 删掉不影响任何行为。 */
      try { window.__paperParts = particles; } catch (e) {}
    });
  })();
</script>
