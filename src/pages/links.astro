---
/* =========================================================
 *  友链页面（/links/）—— 参考 Kisara 主题的「keep the route open」
 *  ---------------------------------------------------------
 *  结构：全屏场景背景 + 左侧大字 + 右侧玻璃面板（轨道图形 + 列表 + 空位）
 *  数据在 src/data/links.js（加友链只改那个文件），
 *  背景图在下面 BG 这一行改。
 * ======================================================= */
import Base from '../layouts/Base.astro';
import config from '../data/config.js';
import links from '../data/links.js';
import { asset } from '../lib/url.js';
import { pad2 } from '../lib/format.js';

// 全屏场景背景：想换就改这一行（放 public/ 下的相对路径）
const BG = 'media/images/home-finale.jpg';

// 面板里显示几个"槽位"（真实友链之后，剩下的显示为等待写入的空位）
const SLOTS = 4;

const list = links.filter((l) => !l.open);
const openInfo = links.find((l) => l.open);
const empty = Math.max(0, SLOTS - list.length);
const mineName = config.name || 'IRinsho';
---

<Base title={`友链 · ${mineName}`} description="keep the route open. 友链与开放路线。">
  <section class="route" style={`--route-bg:url(${asset(BG)})`}>
    {/* 细弧线：纯 CSS 画的轨道/连线，零素材 */}
    <span class="route-lines" aria-hidden="true"><i></i><i></i><i></i><i></i></span>

    <div class="route-left">
      <div class="eyebrow">
        <span class="eyebrow-num">ED / 06</span>
        <span class="eyebrow-line"></span>
        <span class="eyebrow-text">FRIEND ROUTE</span>
      </div>

      <h1 class="route-title">
        keep the<br />route<br /><em>open.</em>
      </h1>

      <p class="route-p">
        有些链接不是目录里的地址，而是某一次认真看完之后，仍然愿意互相留下的坐标。
      </p>
      <p class="route-p route-p--dim">
        这里预留给友链。等名字和网址被写入以后，空位会成为新的彩线交点。
      </p>
    </div>

    <aside class="route-panel">
      <p class="route-panel-head">
        {mineName.toUpperCase()} / FRIENDS <i>///</i> LINKS THAT STAY
      </p>

      {/* 轨道图形：中心一块心形，外面两圈斜着的环在慢转 */}
      <div class="route-orb" aria-hidden="true">
        <span class="orb-ring orb-ring--a"></span>
        <span class="orb-ring orb-ring--b"></span>
        <span class="orb-core">♡</span>
        <span class="orb-dot orb-dot--a"></span>
        <span class="orb-dot orb-dot--b"></span>
      </div>

      <ul class="route-list">
        {list.map((l, i) => (
          <li>
            <a href={l.url} target="_blank" rel="noopener noreferrer">
              <span class="route-no">{pad2(i + 1)}</span>
              <span class="route-info">
                <span class="route-kicker">OPEN ROUTE</span>
                <span class="route-name">{l.name}</span>
                <span class="route-desc">{l.desc}</span>
              </span>
              <span class="route-go" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}

        {[...Array(empty)].map((_, i) => (
          <li class="is-empty">
            <span class="route-no">{pad2(list.length + i + 1)}</span>
            <span class="route-info">
              <span class="route-kicker">OPEN ROUTE</span>
              <span class="route-name">等待被写下的名字</span>
              <span class="route-desc">可以放博客、作品集或小站</span>
            </span>
          </li>
        ))}
      </ul>

      <p class="route-panel-foot">
        <span>NO DEADLINE</span>
        <span>keep something beautiful in orbit</span>
      </p>
    </aside>

    <div class="route-bottom">
      <a class="route-back" href={asset('me/')}><span>←</span>BACK TO ME / PROFILE</a>
      <span class="route-slots">
        <b>LINK SLOTS / {pad2(SLOTS)}</b>
        {openInfo ? '想交换友链就看这里：把我的站加进你的友链页，再来 ME 页面留言。' : ''}
      </span>
    </div>
  </section>
</Base>
