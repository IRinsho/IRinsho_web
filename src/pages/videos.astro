---
import Base from '../layouts/Base.astro';
import videos from '../data/videos.js';
import autoCovers from '../data/covers.generated.js';
import { asset } from '../lib/url.js';
import { resolveEmbed } from '../lib/embeds.js';
import { fmtSlash, hueFor } from '../lib/format.js';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

/* 校验 videos.js 里写的 poster 文件是否真的存在。
   为什么需要：同步工具曾经把一张抓错的图（后来被删掉）写进 poster，
   于是页面一直去请求一个不存在的文件 —— 优先级又高于自动封面，
   结果卡片永远空白。这里直接检查文件，不存在就当没填，
   让下面的自动封面 / 生成底图接管。 */
function posterExists(p) {
  const v = String(p || '').trim();
  if (!v) return false;
  if (/^https?:\/\//i.test(v)) return true;      // 外链不检查
  const rel = v.replace(/\\/g, '/').replace(/^(\.?\/)+/, '');
  try {
    return existsSync(join(process.cwd(), 'public', rel));
  } catch (e) {
    return true;   // 检查失败就按存在处理，别误伤
  }
}

/* 每条视频先算好「播放器地址」「原站链接」「封面」「标题 / 日期 / 时长」：
   douyin / embed 里可以直接粘抖音、B站、YouTube 的分享链接，
   这里统一翻译成 iframe 能用的地址。

   封面优先级：
     1. videos.js 里手填的 poster（最高，你说了算）
     2. 抓来的封面（B站 / YouTube 能自动抓）/ coverUrl（手动粘的图）
     3. 生成底图（色调由标题推导，稳定不随机）
   不想要任何自动封面 → cover: false

   live: true  → 卡片里直接嵌播放器显示真实画面（默认关，见下面说明）
   live 默认关的原因：抖音播放器塞进 16:9 的卡片后会变成
   「上面一大块黑 + 抖音 logo，下面一条画面」，比生成底图难看得多。
   竖屏视频（抖音）→ 自动按 9:16 显示；要强制横屏写 vertical: false

   标题 / 日期 / 时长：videos.js 里写了就用你的，空着就用抓来的值兜底。 */
const items = videos.map((v) => {
  const source = v.embed || v.douyin || '';
  const key = String(source).trim();
  const r = resolveEmbed(source);
  const auto = v.cover === false ? {} : (autoCovers[key] || {});

  const platform = v.platform || r.platform || '';
  // 视频画面比例，优先级：
  //   1. videos.js 里手写的 ratio（'3:4' / '16:9' / '9:16' 都行）—— 最准
  //   2. B站接口 / 抓取时拿到的真实尺寸
  //   3. 本地视频：播放器加载后由浏览器读 videoWidth/videoHeight 自动算（精确）
  //   4. 抖音这类跨域 iframe：读不到，退回按平台猜（抖音 = 竖屏）
  const rawRatio = String(v.ratio || auto.ratio || '').trim();
  const ratioCss = /^\d+(\.\d+)?\s*[:/]\s*\d+(\.\d+)?$/.test(rawRatio)
    ? rawRatio.replace(':', ' / ')
    : '';
  // 竖屏标记：**只在手写 vertical: true 时才用**。
  // 以前按平台猜（抖音=竖屏）是错的 —— 实测抖音里横屏视频也很多，
  // 猜错就会变成一个竖长条里塞一条横画面。比例读不到时，网页默认按横屏更稳。
  const vertical = v.vertical === true;
  // 卡片里嵌播放器：默认关（抖音播放器塞进卡片会变成「黑块 + logo + 一条画面」）
  const live = v.live === true;
  // 弹窗里嵌播放器：**默认开**（不想跳转到抖音，就在页面里播）。
  // 想改成「只给跳转按钮」：在那条上写 playInline: false。
  const playInline = v.playInline !== false;

  return {
    ...v,
    title: v.title || auto.title || '未命名',
    date: v.date || auto.date || '',
    duration: v.duration || auto.duration || '',
    embedUrl: r.embed,
    sourceUrl: v.link || r.link || r.embed,
    platform,
    vertical,
    live,
    playInline,
    ratioCss,
    cover: (posterExists(v.poster) ? v.poster : '') || auto.poster || ''
  };
});

const cats = ['全部'].concat(
  items.reduce((acc, v) => {
    const c = String(v.category || '').trim();
    if (c && acc.indexOf(c) === -1) acc.push(c);
    return acc;
  }, [])
);
const countOf = (c) => (c === '全部' ? items.length : items.filter((v) => String(v.category || '').trim() === c).length);

const sorted = items.slice().sort((a, b) => String(b.date || '').localeCompare(String(a.date || '')));
---
<Base title="视频 · IRinsho">
  <div class="page-head">
    <div class="eyebrow">
      <span class="eyebrow-num">003</span>
      <span class="eyebrow-line"></span>
      <span class="eyebrow-text">VIDEO / SIGNAL LOG</span>
    </div>
    <div class="page-title-row">
      <h1 class="page-title">视频</h1>
      <p class="page-sub">{items.length} 个视频</p>
    </div>
  </div>

  <div class="filters" id="videoFilters">
    {cats.map((c, i) => (
      <button class={'filter' + (i === 0 ? ' active' : '')} data-category={c}>{c}<i>{countOf(c)}</i></button>
    ))}
  </div>

  <div class="video-grid" id="videoGrid">
    {sorted.map((v, i) => (
      <article
        class="video-card"
        data-index={i}
        data-category={String(v.category || '').trim()}
        data-title={v.title}
        data-meta={[v.category, fmtSlash(v.date), v.duration, (v.embedUrl || v.sourceUrl) ? (v.platform || '外链') : ''].filter(Boolean).join('  /  ')}
        data-desc={v.desc || ''}
        data-embed={v.embedUrl}
        data-link={v.sourceUrl || ''}
        data-platform={v.platform || '原站'}
        data-vertical={v.vertical ? '1' : ''}
        data-ratio={v.ratioCss || ''}
        data-inline={v.playInline === false ? '0' : '1'}
        data-src={v.embedUrl ? '' : asset(v.src || '')}
        data-poster={v.cover ? asset(v.cover) : ''}
        data-hue={hueFor(v.title)}
        tabindex="0"
        role="button"
      >
        <div class={'thumb' + (!v.cover && v.embedUrl ? (v.live ? ' thumb--live' : ' thumb--gen') : '')}>
          {v.cover ? (
            <img
              src={asset(v.cover)}
              alt={v.title}
              loading="lazy"
              data-fallback={v.poster && v.poster !== v.cover ? asset(v.poster) : ''}
              onerror="const fb=this.dataset.fallback;if(fb){this.dataset.fallback='';this.src=fb;}else{console.warn('[视频封面加载失败]',this.getAttribute('src'));this.parentNode.classList.add('thumb-broken');this.remove();}"
            />
          ) : v.embedUrl && v.live ? (
            /* live: true —— 直接把播放器嵌进卡片。
               这样卡片上显示的就是这条视频的真实画面（相当于「从视频里取一帧」），
               代价是每张卡多一个 iframe，所以默认不开，只给需要的视频用。 */
            <iframe
              class="thumb-live"
              src={v.embedUrl}
              title={v.title}
              loading="lazy"
              scrolling="no"
              frameborder="0"
              allow="autoplay; fullscreen; encrypted-media; picture-in-picture"
            ></iframe>
          ) : v.embedUrl ? (
            /* 没有封面（外链视频常见）：生成一张设计过的底图，
               而不是留一块灰暗的空白 —— 色调由标题推导，稳定不随机 */
            <div class="thumb-gen" style={`--h:${hueFor(v.title)}`}>
              <b>{v.title}</b>
              <span class="tg-hint">▶ 点开播放</span>
            </div>
          ) : <div class="thumb-fallback"></div>}
          <span class="play">▶</span>
          {v.duration && <span class="dur">{v.duration}</span>}
          {v.platform && <span class="src-tag">{v.platform}</span>}
        </div>
        <div class="vc-body">
          <h3>{v.title}</h3>
          {v.desc && <p>{v.desc}</p>}
          <div class="vc-meta">{v.category || '未分类'} / {fmtSlash(v.date)}{v.duration ? ' / ' + v.duration : ''}</div>
          {v.tags && v.tags.length > 0 && (
            <div class="chips">
              {v.tags.map((t) => <span class="chip">#{t}</span>)}
            </div>
          )}
        </div>
      </article>
    ))}
  </div>

  {items.length === 0 && (
    <p class="empty">还没有视频。把 mp4 放进 <code>public/media/videos/</code>，然后在 <code>src/data/videos.js</code> 里登记一条。</p>
  )}

  <!-- 播放弹窗 -->
  <div class="modal" id="videoModal" hidden>
    <div class="modal-backdrop" data-modal="close"></div>
    <div class="modal-panel">
      <div class="modal-head">
        <div>
          <h3 id="vmTitle"></h3>
          <p id="vmMeta"></p>
        </div>
        <button class="icon-btn" data-modal="close" aria-label="关闭">✕</button>
      </div>
      <div class="modal-body" id="vmBody"></div>
      <p class="modal-desc" id="vmDesc"></p>
    </div>
  </div>

  <script>
    const modal = document.getElementById('videoModal');
    const body = document.getElementById('vmBody');
    const panel = modal.querySelector('.modal-panel');

    function open(card) {
      document.getElementById('vmTitle').textContent = card.dataset.title || '';
      document.getElementById('vmMeta').textContent = card.dataset.meta || '';
      document.getElementById('vmDesc').textContent = card.dataset.desc || '';

      // 用 DOM 接口搭播放器，不用拼字符串：
      // 文件名里带引号、括号、中文都不会把标签拼坏
      body.replaceChildren();

      // 画面比例：优先用手写的 / 抓来的真实比例；
      // 都没有时（比如抖音这种跨域 iframe）先按平台猜，本地视频会在加载后自动纠正
      const ratio = card.dataset.ratio || '';
      body.style.removeProperty('--ratio');
      body.style.removeProperty('--rn');

      // css: "1080 / 1920" 这种；num: 宽/高 的数值（CSS 里要用它算贴合尺寸）
      const useRatio = (css, num) => {
        if (!(num > 0)) return;
        body.style.setProperty('--ratio', css);
        body.style.setProperty('--rn', String(num));
        body.classList.add('has-ratio');
        // 竖屏 → 弹窗收窄 + 手机上占满屏
        // 横屏 → 手机上收成居中卡片（占满屏会在上下留一大片空黑）
        const portrait = num < 1;
        panel.classList.toggle('narrow', portrait);
        panel.classList.toggle('compact', !portrait);
      };

      // 比例来源：手写 vertical / 手写 ratio / 抓来的 ratio，都没有就按横屏 16:9
      if (card.dataset.vertical === '1') {
        useRatio('9 / 16', 9 / 16);
      } else if (ratio) {
        const p = ratio.split('/').map((x) => parseFloat(x));
        if (p.length === 2) useRatio(ratio, p[0] / p[1]);
        else useRatio('16 / 9', 16 / 9);
      } else {
        // 没有比例信息（抖音这类跨域 iframe 读不到尺寸）：按横屏处理，
        // 手机上收成居中卡片，不会上下留一大片空黑
        useRatio('16 / 9', 16 / 9);
      }

      if (card.dataset.embed) {
        const platform = card.dataset.platform || '原站';
        const link = card.dataset.link || '';
        // inline: 在页面内播放（默认）；否则只给「去原站观看」按钮
        const inline = card.dataset.inline !== '0' && !!card.dataset.embed;

        const stage = document.createElement('div');
        stage.className = 'embed-stage';

        const poster = card.dataset.poster;
        if (poster) {
          const img = document.createElement('img');
          img.src = poster;
          img.alt = '';
          stage.appendChild(img);
        } else {
          // 没封面时用同款「生成底图」，别让弹窗里是一块纯黑
          const gen = document.createElement('div');
          gen.className = 'embed-gen';
          gen.style.setProperty('--h', card.dataset.hue || '280');
          const b = document.createElement('b');
          b.textContent = card.dataset.title || '';
          gen.appendChild(b);
          stage.appendChild(gen);
        }

        if (inline) {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'embed-play';
          btn.innerHTML = '<span>▶</span>播放';

          btn.addEventListener('click', () => {
            // 套一层「我们自己的播放器外壳」：标题条 + 画面 + 脚注。
            // 官方播放器只出现在画面那一格，其余边框、配色、出口都是我们的。
            const shell = document.createElement('div');
            shell.className = 'player';

            const bar = document.createElement('div');
            bar.className = 'player-bar';
            const dot = document.createElement('i');
            dot.className = 'player-dot';
            dot.textContent = '▶';
            const name = document.createElement('b');
            name.textContent = card.dataset.title || '';
            const tag = document.createElement('span');
            tag.className = 'player-tag';
            tag.textContent = [platform, card.dataset.duration].filter(Boolean).join(' · ');
            bar.append(dot, name, tag);

            const screen = document.createElement('div');
            screen.className = 'player-screen';
            const iframe = document.createElement('iframe');
            iframe.src = card.dataset.embed;
            iframe.allow = 'autoplay; fullscreen; encrypted-media; picture-in-picture';
            iframe.allowFullscreen = true;
            iframe.setAttribute('scrolling', 'no');
            iframe.setAttribute('frameborder', '0');
            iframe.setAttribute('referrerpolicy', 'unsafe-url');
            screen.appendChild(iframe);

            const foot = document.createElement('div');
            foot.className = 'player-foot';
            const note = document.createElement('span');
            note.textContent = '画面由 ' + platform + ' 提供';
            foot.appendChild(note);
            if (link) {
              const out = document.createElement('a');
              out.href = link;
              out.target = '_blank';
              out.rel = 'noopener noreferrer';
              out.textContent = '在新窗口打开 ↗';
              foot.appendChild(out);
            }

            shell.append(bar, screen, foot);
            stage.replaceChildren(shell);
            stage.classList.add('is-playing');
          });

          stage.appendChild(btn);
        } else {
          // 主要动作：去原站看（在抖音 App / 网页里播放，画面由对方负责，干干净净）
          const a = document.createElement('a');
          a.className = 'embed-play';
          a.href = link || card.dataset.embed;
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
          a.innerHTML = '<span>▶</span>去' + platform + '观看';
          stage.appendChild(a);
        }

        body.appendChild(stage);

        // 一行小提示 + 备用出口（播放器万一放不出来还能跳过去看）
        const bar = document.createElement('p');
        bar.className = 'embed-bar';
        bar.appendChild(document.createTextNode(inline ? '放不出来？' : platform + ' 的播放器带自己的界面，'));
        if (link) {
          const go = document.createElement('a');
          go.className = 'play-download';
          go.href = link;
          go.target = '_blank';
          go.rel = 'noopener noreferrer';
          go.textContent = inline ? '去' + platform + '看 ↗' : '点这里去' + platform;
          bar.appendChild(go);
        }
        if (inline) {
          const hint = document.createElement('span');
          hint.className = 'embed-hint';
          hint.textContent = '外站播放器需要对方允许嵌入；一直空白或提示无权限时，请点这个按钮。';
          bar.appendChild(hint);
        }
        body.appendChild(bar);
      } else if (!card.dataset.src) {
        const tip = document.createElement('p');
        tip.className = 'play-error';
        tip.textContent = '这条视频没填 src：在 src/data/videos.js 里补上 ' +
          "src: 'media/videos/文件名.mp4'（或者用 embed 嵌外链）。";
        body.appendChild(tip);
      } else {
        const video = document.createElement('video');
        video.controls = true;
        video.autoplay = true;
        video.playsInline = true;
        video.preload = 'auto';
        if (card.dataset.poster) video.poster = card.dataset.poster;
        video.src = card.dataset.src;   // 路径已由 asset() 转义，能正常取到文件

        // 本地视频：读到元数据后就知道真实尺寸了，按它调整弹窗比例（最准的一路）
        video.addEventListener('loadedmetadata', () => {
          if (!video.videoWidth || !video.videoHeight) return;
          const num = video.videoWidth / video.videoHeight;
          const css = video.videoWidth + ' / ' + video.videoHeight;
          if (body.style.getPropertyValue('--ratio') === css) return;
          body.style.setProperty('--ratio', css);
          body.style.setProperty('--rn', String(num));
          body.classList.add('has-ratio');
          const portrait = num < 1;
          panel.classList.toggle('narrow', portrait);
          panel.classList.toggle('compact', !portrait);
        });

        video.addEventListener('error', () => {
          // 看 data-src（原始值一定在），不要看 video.getAttribute('src')：
          // 视频元素在出错/清空时会丢掉 src，那样提示里的路径就是空的
          const srcAttr = card.dataset.src || '';
          let shown = srcAttr.replace(/^\//, '');
          try { shown = decodeURI(shown); } catch (e) { /* 编码不合法就显示原样 */ }

          const tip = document.createElement('p');
          tip.className = 'play-error';
          if (/^https?:\/\//i.test(shown)) {
            tip.textContent = '这个视频打不开：' + shown +
              '。这个地址不是本地文件，要嵌外站视频请用 douyin / embed 字段（见 src/data/videos.js 的说明）。';
          } else {
            tip.textContent = '这个视频打不开：检查文件是否在 public/' + shown +
              '，或者换个浏览器支持的格式（推荐 mp4 / H.264）。';
          }

          const dl = document.createElement('a');
          dl.className = 'play-download';
          dl.href = srcAttr;
          dl.setAttribute('download', '');
          dl.textContent = '↓ 直接下载这个文件试试';
          body.replaceChildren(tip, dl);
        });

        body.appendChild(video);
      }

      modal.hidden = false;
      document.body.style.overflow = 'hidden';
    }

    function close() {
      modal.hidden = true;
      body.innerHTML = '';   // 清空以停止播放
      document.body.style.overflow = '';
    }

    document.getElementById('videoFilters').addEventListener('click', (e) => {
      const btn = e.target.closest('.filter');
      if (!btn) return;
      document.querySelectorAll('#videoFilters .filter').forEach((b) => b.classList.toggle('active', b === btn));
      const cat = btn.dataset.category;
      document.querySelectorAll('.video-card').forEach((el) => {
        el.hidden = cat !== '全部' && el.dataset.category !== cat;
      });
    });

    document.getElementById('videoGrid').addEventListener('click', (e) => {
      const card = e.target.closest('.video-card');
      if (card) open(card);
    });

    modal.addEventListener('click', (e) => {
      // 弹窗里的「去原站看」是链接，点它不要顺手把弹窗关掉
      if (e.target.closest('a')) return;
      if (e.target.closest('[data-modal]')) close();
    });

    document.addEventListener('keydown', (e) => {
      if (!modal.hidden && e.key === 'Escape') close();
    });
  </script>
</Base>
