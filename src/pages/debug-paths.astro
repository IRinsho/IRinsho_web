---
/* =========================================================
 *  资源自检页  ——  /debug-paths/
 *  ---------------------------------------------------------
 *  作用：把网站上引用到的图片 / 视频 / 封面 / 样式，一条条列出来，
 *        并标注「文件在不在 public/ 里」。
 *
 *  什么时候用：
 *    · 首页某一格是空的、图片显示不出来
 *    · 视频点了播放没反应
 *    · 换了电脑 / 换服务器之后想看看到底缺了哪些文件
 *
 *  打开方式：启动网站后访问  http://localhost:4321/debug-paths/
 *
 *  看腻了可以直接删掉这个文件（src/pages/debug-paths.astro），
 *  它不影响网站其他任何页面。
 * ======================================================= */
import Base from '../layouts/Base.astro';
import config from '../data/config.js';
import videos from '../data/videos.js';
import { photos } from '../lib/photos.js';
import { asset } from '../lib/url.js';
import { existsSync } from 'node:fs';
import { join, dirname } from 'node:path';
import { fileURLToPath } from 'node:url';

// 项目根目录（src/pages/ 往上两级），比 process.cwd() 更靠谱
let projectRoot = process.cwd();
try {
  projectRoot = join(dirname(fileURLToPath(import.meta.url)), '..', '..');
} catch (e) { /* 取不到就用当前工作目录 */ }

// 每格首页底图的选择逻辑（和 index.astro 保持一致）
function firstOf(list) {
  return list.find((x) => x && String(x).trim()) || '';
}
function panelArt(key) {
  const pool = [config.avatar, (videos[0] && videos[0].poster), ...photos.map((p) => p.src)];
  if (key === 'videos') return firstOf([(videos[0] && videos[0].poster), config.avatar]) || firstOf(pool);
  if (key === 'me') return firstOf([config.avatar, (videos[0] && videos[0].poster)]) || firstOf(pool);
  const idx = { home: 0, photos: 1, notes: 2 }[key];
  const picked = firstOf([photos[idx == null ? 0 : idx] && photos[idx == null ? 0 : idx].src]);
  return picked || firstOf(pool) || '';
}

const PANELS = [
  { name: 'HOME', key: 'home' },
  { name: 'GALLERY', key: 'photos' },
  { name: 'VIDEO', key: 'videos' },
  { name: 'BLOG', key: 'notes' },
  { name: 'ME', key: 'me' }
].map((p) => ({ name: p.name, raw: panelArt(p.key) }));

/* ---------- 收集全部引用 ---------- */
const refs = [];

function add(label, raw, extra = {}) {
  refs.push({ label, raw, ...extra });
}

add('顶栏 LOGO 右边的小图标', 'favicon.svg');
add('全站样式表', 'assets/css/style.css');
add('顶栏右上角头像 · config.avatar', config.avatar);
add('个人页左侧大图 · me.photo', config.me && config.me.photo);

PANELS.forEach((p) => add('首页 ' + p.name + ' 那一格的底图', p.raw));

photos.forEach((p, i) => {
  add('相册第 ' + (i + 1) + ' 张（' + (p.title || p.file || '') + '）', p.src);
});

videos.forEach((v, i) => {
  const n = '第 ' + (i + 1) + ' 条视频「' + (v.title || '') + '」';
  if (v.embed) add(n + ' · 外链嵌入', '', { note: '外链，不需要本地文件：' + v.embed });
  else add(n + ' · 视频源 src', v.src);
  if (v.poster) add(n + ' · 封面 poster', v.poster);
});

/* ---------- 逐条检查文件是否存在 ---------- */
const rows = refs.map((r) => {
  const raw = String(r.raw == null ? '' : r.raw).trim();
  const url = raw ? asset(raw) : '';

  // 本地相对路径 → public/ 下的真实文件
  const isLocal = raw && !/^(https?:)?\/\//i.test(raw) && !raw.startsWith('data:');
  const diskRel = raw.replace(/\\/g, '/').replace(/^(\.?\/)+/, '');
  const disk = join(projectRoot, 'public', diskRel);
  const ok = isLocal ? existsSync(disk) : true;

  return {
    label: r.label,
    raw,
    url,
    note: r.note || '',
    // 中文、空格、括号会被转义，这里把转义后的样子也显示出来，方便对照
    encoded: /[^\x20-\x7e]/.test(url) || /%[0-9A-Fa-f]{2}/.test(url) ? url : '',
    ok,
    isLocal
  };
});

const missing = rows.filter((r) => !r.ok);
const hasEmbed = videos.some((v) => v.embed);
---

<Base title="资源自检 · IRinsho">
  <div class="page-head">
    <div class="eyebrow">
      <span class="eyebrow-num">DBG</span>
      <span class="eyebrow-line"></span>
      <span class="eyebrow-text">ASSET CHECK / PATHS</span>
    </div>
    <div class="page-title-row">
      <h1 class="page-title">资源自检</h1>
      <p class="page-sub">共 {rows.length} 条引用 · 缺 {missing.length} 条</p>
    </div>
  </div>

  {missing.length === 0 ? (
    <p class="dbg-ok">✓ 所有本地文件都在，页面上的图片和视频应该都能正常加载。</p>
  ) : (
    <div class="dbg-miss">
      <p>✗ 下面这 {missing.length} 条引用的文件在 <code>public/</code> 里找不到：</p>
      <ul>
        {missing.map((m) => (
          <li><code>{m.raw}</code> —— {m.label}</li>
        ))}
      </ul>
      <p>
        要么把文件补进去，要么把 <code>src/data/config.js</code> /{' '}
        <code>src/data/videos.js</code> 里的路径改成实际存在的文件。
      </p>
    </div>
  )}

  <div class="dbg-table-wrap">
    <table class="dbg-table">
      <thead>
        <tr><th>状态</th><th>用在哪</th><th>数据文件里写的</th><th>页面实际请求的地址</th></tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr class={r.ok ? '' : 'bad'}>
            <td class="dbg-state">{r.ok ? '✓' : '✗'}</td>
            <td>{r.label}</td>
            <td><code>{r.note || r.raw || '（空）'}</code></td>
            <td>
              {r.url && <code>{r.url}</code>}
              {r.encoded && <span class="dbg-enc">（含中文 / 空格 / 括号，已自动转义）</span>}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="dbg-foot">
    {hasEmbed ? '注意：带 embed 的视频走的是外部播放器，不检查本地文件。' : ''}
    判定规则：把上面「数据文件里写的」当成 <code>public/</code> 下的相对路径去找文件，找得到就是 ✓。
  </p>

  <!-- 说明 -->
  <div class="dbg-howto">
    <h2>上面是「文字版」，这里是「看得见版」</h2>
    <p>
      首页每一格的底图、顶栏头像，下面直接用 <code>&lt;img&gt;</code> 再渲染一遍。
      这样一次就能看出到底是「路径不对」还是「图片本身有问题」：
      <b>自检表里是 ✓ 但下面这一片是空框，那就是图片文件本身读不出来。</b>
    </p>
  </div>

  <!-- 首页每一格的底图，实图预览 -->
  <h2 class="dbg-h2">首页每一格底图 / 顶栏头像</h2>
  <div class="dbg-previews">
    <figure class="dbg-pv">
      <img src={asset(config.avatar)} alt="头像" />
      <figcaption>顶栏头像<br><code>{asset(config.avatar)}</code></figcaption>
    </figure>
    {PANELS.map((p) => (
      <figure class="dbg-pv">
        {p.raw ? <img src={asset(p.raw)} alt={p.name} /> : <div class="dbg-pv-none">没有取到图片</div>}
        <figcaption>{p.name}<br><code>{p.raw ? asset(p.raw) : '（空）'}</code></figcaption>
      </figure>
    ))}
  </div>

  <!-- 相册全部图片，实图预览 -->
  <h2 class="dbg-h2">相册里的 {photos.length} 张图</h2>
  <div class="dbg-previews">
    {photos.map((p) => (
      <figure class="dbg-pv">
        <img src={asset(p.src)} alt={p.title} />
        <figcaption>{p.title}<br><code>{asset(p.src)}</code></figcaption>
      </figure>
    ))}
  </div>

  <!-- 视频封面 + 视频文件是否可访问 -->
  <h2 class="dbg-h2">视频</h2>
  <div class="dbg-previews">
    {videos.map((v) => (
      <figure class="dbg-pv dbg-pv-wide">
        {v.poster ? <img src={asset(v.poster)} alt={v.title} /> : <div class="dbg-pv-none">没有封面</div>}
        <figcaption>
          {v.title}<br>
          {v.src && <code>src: {asset(v.src)}</code>}
          {v.embed && <code>embed: {v.embed}</code>}
        </figcaption>
      </figure>
    ))}
  </div>
</Base>
