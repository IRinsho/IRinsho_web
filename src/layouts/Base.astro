---
import config from '../data/config.js';
import { asset } from '../lib/url.js';
// 页面切换的视觉过渡（Astro 内置）——
// 换页时不会白屏闪一下，而是像 Kisara 主题那样平滑淡入淡出，
// 顶栏因为位置不变会自动保持，看起来像「内容在换、外壳没动」
import { ClientRouter } from 'astro:transitions';
// 内页共用的首屏舞台（各页通过 hero / heroKicker / heroSub 传内容）
import Gate from '../components/Gate.astro';
// 首页专用的开场（纸做的电影片头）。只在 isHome 时渲染。
import Opening from '../components/Opening.astro';

const {
  title = config.name,
  description = '',
  // 传了 hero 就渲染首屏舞台；不传（首页 / 友链页）保持原样
  hero = '',
  heroKicker = 'CHAPTER',
  heroSub = '',
  heroImage = '',
  // 单页分享图（Open Graph / Twitter 卡片）。不传就用 config.ogImage
  image = '',
  // 只有首页传 true：那才会渲染"纸做的电影片头"开场
  isHome = false
} = Astro.props;

// 注意：属性解构统一在上面那段（title / description / hero…），
// 这里不要再写一次 —— 否则 "The symbol title has already been declared"，构建会直接失败。

// 当前在哪个板块（用于 body 的属性，个人页整页换浅粉底色）
const path = Astro.url.pathname;
const view = path === '/' || path === ''
  ? 'home'
  : /^\/photos/.test(path) ? 'photos'
  : /^\/videos/.test(path) ? 'videos'
  : /^\/notes/.test(path) ? 'notes'
  : /^\/me/.test(path) ? 'me'
  : 'home';

const ICONS = {
  home: '<path d="M3 10.5 12 3l9 7.5"/><path d="M5.8 9.2V20h12.4V9.2"/>',
  photos: '<rect x="3" y="4.5" width="18" height="15" rx="2"/><circle cx="8.6" cy="9.6" r="1.5"/><path d="m4 17.5 5-5 4 4 3-2.5 4 3.5"/>',
  videos: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m10.5 9.2 5 2.8-5 2.8z"/>',
  notes: '<path d="M6.5 3h8L19 7.5V21H6.5z"/><path d="M14.5 3v4.5H19"/><path d="M9.5 12.5h6M9.5 16h6"/>',
  me: '<circle cx="12" cy="8.6" r="3.6"/><path d="M5 20.5c0-3.9 3.1-6.6 7-6.6s7 2.7 7 6.6"/>',
  links: '<path d="M10.5 13.5a3.6 3.6 0 0 0 5.1 0l2.4-2.4a3.6 3.6 0 0 0-5.1-5.1l-1 1"/><path d="M13.5 10.5a3.6 3.6 0 0 0-5.1 0l-2.4 2.4a3.6 3.6 0 0 0 5.1 5.1l1-1"/>'
};

const NAV = [
  { key: 'home', href: '/', label: 'HOME', no: '01' },
  { key: 'photos', href: '/photos/', label: 'GALLERY', no: '02' },
  { key: 'videos', href: '/videos/', label: 'VIDEO', no: '03' },
  { key: 'notes', href: '/notes/', label: 'BLOG', no: '04' },
  { key: 'me', href: '/me/', label: 'ME', no: '05' }
  // 友链不放顶栏（用户要求）：入口在首页里，见 index.astro 的 .friend-entry
];

// 顶栏左侧品牌：编号 = 当前板块在导航里的序号（Kisara 那种「KISARA / 03」的味道）
const currentIndex = Math.max(0, NAV.findIndex((n) => n.key === view));
const brandNo = String(currentIndex + 1).padStart(2, '0');
const viewLabel = (NAV[currentIndex] && NAV[currentIndex].label) || 'HOME';

// 品牌名分色
const name = config.name || '';
const accent = config.nameAccent || '';
const ai = accent ? name.indexOf(accent) : -1;
const nameBefore = ai >= 0 ? name.slice(0, ai) : name;
const nameAfter = ai >= 0 ? name.slice(ai + accent.length) : '';

const year = new Date().getFullYear();
const footerRaw = String(config.footer || '');
// 页脚里写了 {year} 就替换成当前年份；没写就原样显示
const footerText = footerRaw.includes('{year}')
  ? footerRaw.replace(/\{year\}/g, year)
  : footerRaw;

/* ---------- SEO / 分享（Open Graph、Twitter Card、canonical） ----------
   绝对地址只在 config.site 填了之后才生成；没填就用相对地址兜底，
   网站照常打开，只是微信 / QQ / Twitter 抓不到预览图。 */
const site = String(config.site || '').trim().replace(/\/+$/, '');
const ogImageSrc = image || config.ogImage || 'media/images/home-hero.jpg';
const ogTitle = title;
const ogDescription = description || config.homeMotto || '';
const ogType = Astro.url.pathname === '/' ? 'website' : 'article';
const canonical = site ? new URL(Astro.url.pathname, site).href : '';
const ogUrl = site ? new URL(Astro.url.pathname, site).href : '';
const ogImageUrl = site
  ? new URL(asset(ogImageSrc).replace(/^\//, ''), site).href
  : asset(ogImageSrc);
const themeColor = view === 'me' ? '#f8ebf0' : '#12142a';
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{title}</title>
  <meta name="author" content={config.author || config.name}>
  {description && <meta name="description" content={description}>}
  {canonical && <link rel="canonical" href={canonical}>}
  <meta name="theme-color" content={themeColor}>

  <!-- 分享（Open Graph / Twitter Card）：微信 / QQ / Twitter / 搜索引擎 -->
  <meta property="og:site_name" content={config.name}>
  <meta property="og:title" content={ogTitle}>
  <meta property="og:description" content={ogDescription}>
  <meta property="og:type" content={ogType}>
  <meta property="og:locale" content="zh_CN">
  {ogUrl && <meta property="og:url" content={ogUrl}>}
  {ogImageUrl && <meta property="og:image" content={ogImageUrl}>}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={ogTitle}>
  <meta name="twitter:description" content={ogDescription}>
  {ogImageUrl && <meta name="twitter:image" content={ogImageUrl}>}

  <link rel="icon" href={asset('favicon.svg')}>
  <link rel="stylesheet" href={asset('assets/css/style.css')}>
  <ClientRouter />
  <!-- 首屏之前先把「开了动效」标记写上，避免内容闪一下再消失 -->
  <script is:inline>
    (function () {
      try {
        var reduce = window.matchMedia &&
          window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) return;
        document.documentElement.classList.add('js-motion');

        /* 开场标记：只有"真正的首页硬加载 + 用户允许动效"才加。
           ⚠ 这个类是所有开场样式（纸、字卡、首屏延迟）的总开关：
             它没被加上，纸的 CSS 就永远停在 opacity:0 + visibility:hidden，
             而首屏元素也不会有任何延迟 —— 页面就是一个普通的静态首页。
             换句话说，任何一环出问题，最坏结果都是"没有开场"。 */
        var p = location.pathname;
        var isHome = p === '/' || p === '' || /\/index\.html$/.test(p);
        if (isHome && !document.documentElement.dataset.openingDone) {
          document.documentElement.classList.add('u-opening');
        }
      } catch (e) { /* 忽略：没有开场也要能正常打开 */ }
    })();
  </script>
</head>
<body data-view={view}>

{isHome && <Opening name={name} subtitle={config.homeMotto} folio={`${viewLabel} / ${brandNo} \u00b7 IRINSHO.TOP`} />}

<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" href={asset('')}>
      <span class="brand-mark">◆</span>
      <span class="brand-text">
        <b>{nameBefore}{accent && <em>{accent}</em>}{nameAfter}</b>
        <i class="brand-sub">{viewLabel} / {brandNo}</i>
      </span>
    </a>

    <nav class="tabs" id="navTabs" aria-label="主导航">
      {NAV.map((item) => (
        <a class={'tab' + (item.key === view ? ' active' : '')} href={asset(item.href)}>
          <span class="tab-no">{item.no}</span>
          <svg viewBox="0 0 24 24" set:html={ICONS[item.key]} />
          {item.label}
        </a>
      ))}
    </nav>

    <div class="topbar-actions">
      <a class="avatar-btn" href={asset('me/')} title="个人档案">
        <img src={asset(config.avatar)} alt="头像" onerror="this.classList.add('is-broken')">
      </a>
      <button class="icon-btn menu-btn" id="menuToggle" title="菜单" aria-label="菜单">☰</button>
    </div>
  </div>
</header>

<main id="main">
  {hero && (
    <Gate
      eyebrow={heroKicker}
      title={hero}
      sub={heroSub}
      image={heroImage || 'media/images/home-hero.jpg'}
    />
  )}
  <slot />
</main>

<footer class="footer">
  <span>{footerText}</span>
</footer>

<script>
  /* 窄屏的下拉菜单 —— 必须是「可重复调用且幂等」的：
     开了页面过渡后脚本会在 DOMContentLoaded 和 astro:page-load 各跑一次，
     如果这里直接 addEventListener，就会挂上两个 click，
     一次点击被 toggle 两下（开→关）——表现就是"只有第一次点得动"。
     所以用 dataset.menuBound 挡住重复绑定。 */
  function initMenu() {
    const menuBtn = document.getElementById('menuToggle');
    const tabs = document.querySelector('.tabs');
    if (!menuBtn || !tabs || menuBtn.dataset.menuBound === '1') return;
    menuBtn.dataset.menuBound = '1';

    menuBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      tabs.classList.toggle('open');
    });
    document.addEventListener('click', (e) => {
      if (!e.target.closest('.tabs') && !e.target.closest('#menuToggle')) {
        tabs.classList.remove('open');
      }
    });
  }

  /* =========================================================
   *  ① 滚动进度（替代原来的 IntersectionObserver 浮现）
   *  ---------------------------------------------------------
   *  参考站 yuimi-chaya.github.io（Kisara 主题）在四个首页 CSS 里
   *  `IntersectionObserver` / `is-visible` / `is-in` 全部是 **0 次**。
   *  它只有一套东西：**滚动进度 → CSS 变量 → 形态**（页面底部就写着
   *  "SCROLL = FRAME / STOP = HOLD"）。所有引用都是 var(--kisara-*)。
   *
   *  所以这里不再给每个卡片挂 observer、加 .is-in、错峰 55ms ——
   *  那套的问题：每块内容各自决定"我什么时候浮出来"，
   *  一页长笔记往下滑会不停地有东西在动，视觉上很吵；
   *  而且每次换页都要重新注册一批 observer。
   *
   *  现在只算两个数，写进 <html>：
   *    --scroll-y     已经滚过多少 px（连续）
   *    --scroll-progress  0~1（整页进度，顶栏那条进度轨也用它）
   *  形态交给 CSS（见 style.css「滚动进度」那一段）。
   *  默认页面完全可见 —— 这段脚本只负责写变量，挂了也不影响可读性。
   * ======================================================= */
  const prefersReduced = window.matchMedia &&
    window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function startScrollProgress() {
    try {
      if (prefersReduced) return;
      const root = document.documentElement;
      if (root.dataset.scrollProgress === '1') return;   // 幂等
      root.dataset.scrollProgress = '1';

      let ticking = false;

      function write() {
        ticking = false;
        const y = window.scrollY || 0;
        const total = Math.max(1, root.scrollHeight - window.innerHeight);
        root.style.setProperty('--scroll-y', y.toFixed(1) + 'px');
        root.style.setProperty('--scroll-progress', Math.min(1, y / total).toFixed(4));
      }

      window.addEventListener('scroll', () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(write);
      }, { passive: true });
      window.addEventListener('resize', write, { passive: true });

      write();
    } catch (e) { /* 只是优化，出错不影响页面 */ }
  }

  /* =========================================================
   *  ② 自定义鼠标：**已删除**
   *  ---------------------------------------------------------
   *  参考站 yuimi-chaya.github.io（Kisara 主题）的做法是彻底不要：
   *  在它四个首页 CSS 里 `cursor: none` 出现 0 次。
   *
   *  删掉的理由（也是用户的原话"不跟手、看着廉价"）：
   *    · 它把系统光标换成一个 26px 的圈，圈永远比指针慢一点点 ——
   *      操作系统的光标是零延迟的，任何自定义光标都赢不了
   *    · 圈会跟着指针在链接、卡片上放大/变色/显示 OPEN，
   *      等于满屏都在提示"这里可以点"，抢掉了内容本身的注意力
   *    · 一圈毛玻璃(backdrop-filter) + 磁吸偏移，每帧都要重算
   *  现在系统光标回来了：指针在哪就是哪，最跟手。
   *  （CSS 里的 .cur-* / html.has-cursor 规则也一并删掉了，
   *    所以即使有旧缓存里的 DOM 残留也不会隐藏光标。）
   * ======================================================= */

  /* =========================================================
   *  ③ 导航栏动效
   *  · 鼠标在导航上时，一条玫红指示条会跟着光标滑动
   *  · 点击后立刻把指示条挪到目标位置，换页不闪
   * ======================================================= */
  function startNavIndicator() {
    const nav = document.getElementById('navTabs');
    if (!nav || prefersReduced) return;

    let bar = nav.querySelector('.nav-ind');
    if (!bar) {
      bar = document.createElement('span');
      bar.className = 'nav-ind';
      bar.setAttribute('aria-hidden', 'true');
      nav.appendChild(bar);
    }

    const active = nav.querySelector('.tab.active');
    const moveTo = (el, instant) => {
      if (!el) return;
      const nb = nav.getBoundingClientRect();
      const eb = el.getBoundingClientRect();
      bar.style.width = eb.width + 'px';
      bar.style.transform = `translateX(${eb.left - nb.left}px)`;
      bar.classList.toggle('is-instant', !!instant);
      requestAnimationFrame(() => bar.classList.remove('is-instant'));
      bar.classList.add('is-on');
    };

    // 初始位置（等字体排好，避免宽度量错）
    const start = () => moveTo(active || nav.querySelector('.tab'), true);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(start);
    else setTimeout(start, 120);

    nav.addEventListener('mouseover', (e) => {
      const t = e.target.closest('.tab');
      if (t) moveTo(t);
    });
    nav.addEventListener('mouseleave', () => moveTo(active, true));
    nav.addEventListener('click', (e) => {
      const t = e.target.closest('.tab');
      if (t) moveTo(t, true);
    });
    window.addEventListener('resize', () => moveTo(active, true), { passive: true });
  }

  /* =========================================================
   *  ⑤ 卡片 3D 倾斜 + 光晕跟随：**已删除**
   *  ⑥ 点击涟漪 + 粒子爆发：**已删除**
   *  ---------------------------------------------------------
   *  参考站 yuimi-chaya.github.io（Kisara 主题）在四个首页 CSS 里：
   *    · `perspective(` / `rotateX(` → 0 次（没有卡片 3D 倾斜）
   *    · 点击涟漪 / 粒子爆发 → 完全没有
   *  它卡片唯一的悬停反馈是 `transition: border-color .16s ease-out`。
   *
   *  删掉的理由：
   *    · 3D 倾斜 + 光晕让每张卡片都在"自己动"，一屏五张卡就是五份注意力；
   *      而且倾斜会和 html.reveal 的浮现位移抢同一个 transform
   *    · 点击涟漪在每次点链接/导航时都炸一圈玫红，跟页面切换抢戏；
   *      粒子爆发只在带 data-burst 的元素上，属于"会玩"不是"好看"
   *  现在卡片的悬停反馈改成纯 CSS 的轻微上浮 + 描边变色（见 style.css
   *  的「卡片悬停」那一段），静止时整页是静的。
   * ======================================================= */

  /* =========================================================
   *  ⑦ 滚动状态标记（全站一处，供 CSS 使用）
   *  ---------------------------------------------------------
   *  页面上很多过渡是"慢工出细活"型的（浮现 0.68s、卡片 0.32s…），
   *  静止时它们很舒服，**滚动时**却会拖住整个画面：
   *  过渡要花 0.68s 去追一个一直在变的滚动位置，看起来就是发飘、跟手差。
   *
   *  所以这里只做一件事：滚动期间给 <html> 打上 data-scrolling，
   *  停下 160ms 后摘掉。style.css 里用
   *  `html.reveal[data-scrolling] …` 把过渡时长归零 ——
   *  滚的时候干脆利落，停下来该有的淡入一点都不少。
   *
   *  只在这里维护这一个标记：以前分散在 index.astro / Gate.astro 各写一份，
   *  两个 setTimeout 会互相踩，标记忽有忽无。
   * ======================================================= */

  function startScrollFlag() {
    try {
      if (prefersReduced) return;
      if (document.documentElement.dataset.scrollFlag === '1') return;   // 幂等
      document.documentElement.dataset.scrollFlag = '1';

      const IDLE = 160;
      let timer = 0;

      window.addEventListener('scroll', () => {
        document.documentElement.dataset.scrolling = '1';
        clearTimeout(timer);
        timer = setTimeout(() => {
          delete document.documentElement.dataset.scrolling;
        }, IDLE);
      }, { passive: true });
    } catch (e) { /* 忽略：这只是优化，出错不影响别处 */ }
  }

  /* =========================================================
   *  ④ 换页后重启
   *  ---------------------------------------------------------
   *  开了页面过渡（ClientRouter）后，Astro 换页时会把旧 DOM 整个换掉。
   *  astro:page-load 在「首次加载」和「每次换页完成」都会触发，
   *  所以把需要跟着换页走的东西挂到它上面。
   *  所有初始化函数内部都有幂等保护，重复调用安全。
   *
   *  ⚠ 现在这里只剩三件事，都是"全站一次性"的：
   *    initMenu          窄屏下拉菜单（绑在被换掉的 DOM 上）
   *    startNavIndicator 顶栏指示条宽度要按新页面重新量
   *    startScrollProgress / startScrollFlag  幂等，重复调用直接返回
   *  （光标、卡片倾斜、点击特效都已经按参考站的做法删掉了；
   *    滚动浮现改成 CSS 变量驱动，不需要每次换页重新注册。）
   * ======================================================= */
  function bootMotion() {
    initMenu();
    startNavIndicator();
    startScrollProgress();
    startScrollFlag();
  }

  document.addEventListener('astro:page-load', bootMotion);

  // 没启用页面过渡时的兜底（此时只有一次 DOMContentLoaded）
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bootMotion);
  } else {
    bootMotion();
  }
</script>

</body>
</html>
