---
import config from '../data/config.js';
import { asset } from '../lib/url.js';
// 页面切换的视觉过渡（Astro 内置）——
// 换页时不会白屏闪一下，而是像 Kisara 主题那样平滑淡入淡出，
// 顶栏因为位置不变会自动保持，看起来像「内容在换、外壳没动」
import { ClientRouter } from 'astro:transitions';
// 内页共用的首屏舞台（各页通过 hero / heroKicker / heroSub 传内容）
import Gate from '../components/Gate.astro';
// 首页专用的开场（纸做的电影片头）。只在 isHome 时渲染。
import Opening from '../components/Opening.astro';

const {
  title = config.name,
  description = '',
  // 传了 hero 就渲染首屏舞台；不传（首页 / 友链页）保持原样
  hero = '',
  heroKicker = 'CHAPTER',
  heroSub = '',
  heroImage = '',
  // 单页分享图（Open Graph / Twitter 卡片）。不传就用 config.ogImage
  image = '',
  // 只有首页传 true：那才会渲染"纸做的电影片头"开场
  isHome = false
} = Astro.props;

// 注意：属性解构统一在上面那段（title / description / hero…），
// 这里不要再写一次 —— 否则 "The symbol title has already been declared"，构建会直接失败。

// 当前在哪个板块（用于 body 的属性，个人页整页换浅粉底色）
const path = Astro.url.pathname;
const view = path === '/' || path === ''
  ? 'home'
  : /^\/photos/.test(path) ? 'photos'
  : /^\/videos/.test(path) ? 'videos'
  : /^\/notes/.test(path) ? 'notes'
  : /^\/me/.test(path) ? 'me'
  : 'home';

const ICONS = {
  home: '<path d="M3 10.5 12 3l9 7.5"/><path d="M5.8 9.2V20h12.4V9.2"/>',
  photos: '<rect x="3" y="4.5" width="18" height="15" rx="2"/><circle cx="8.6" cy="9.6" r="1.5"/><path d="m4 17.5 5-5 4 4 3-2.5 4 3.5"/>',
  videos: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m10.5 9.2 5 2.8-5 2.8z"/>',
  notes: '<path d="M6.5 3h8L19 7.5V21H6.5z"/><path d="M14.5 3v4.5H19"/><path d="M9.5 12.5h6M9.5 16h6"/>',
  me: '<circle cx="12" cy="8.6" r="3.6"/><path d="M5 20.5c0-3.9 3.1-6.6 7-6.6s7 2.7 7 6.6"/>',
  links: '<path d="M10.5 13.5a3.6 3.6 0 0 0 5.1 0l2.4-2.4a3.6 3.6 0 0 0-5.1-5.1l-1 1"/><path d="M13.5 10.5a3.6 3.6 0 0 0-5.1 0l-2.4 2.4a3.6 3.6 0 0 0 5.1 5.1l1-1"/>'
};

const NAV = [
  { key: 'home', href: '/', label: 'HOME', no: '01' },
  { key: 'photos', href: '/photos/', label: 'GALLERY', no: '02' },
  { key: 'videos', href: '/videos/', label: 'VIDEO', no: '03' },
  { key: 'notes', href: '/notes/', label: 'BLOG', no: '04' },
  { key: 'me', href: '/me/', label: 'ME', no: '05' }
  // 友链不放顶栏（用户要求）：入口在首页里，见 index.astro 的 .friend-entry
];

// 顶栏左侧品牌：编号 = 当前板块在导航里的序号（Kisara 那种「KISARA / 03」的味道）
const currentIndex = Math.max(0, NAV.findIndex((n) => n.key === view));
const brandNo = String(currentIndex + 1).padStart(2, '0');
const viewLabel = (NAV[currentIndex] && NAV[currentIndex].label) || 'HOME';

// 品牌名分色
const name = config.name || '';
const accent = config.nameAccent || '';
const ai = accent ? name.indexOf(accent) : -1;
const nameBefore = ai >= 0 ? name.slice(0, ai) : name;
const nameAfter = ai >= 0 ? name.slice(ai + accent.length) : '';

const year = new Date().getFullYear();
const footerRaw = String(config.footer || '');
// 页脚里写了 {year} 就替换成当前年份；没写就原样显示
const footerText = footerRaw.includes('{year}')
  ? footerRaw.replace(/\{year\}/g, year)
  : footerRaw;

/* ---------- SEO / 分享（Open Graph、Twitter Card、canonical） ----------
   绝对地址只在 config.site 填了之后才生成；没填就用相对地址兜底，
   网站照常打开，只是微信 / QQ / Twitter 抓不到预览图。 */
const site = String(config.site || '').trim().replace(/\/+$/, '');
const ogImageSrc = image || config.ogImage || 'media/images/home-hero.jpg';
const ogTitle = title;
const ogDescription = description || config.homeMotto || '';
const ogType = Astro.url.pathname === '/' ? 'website' : 'article';
const canonical = site ? new URL(Astro.url.pathname, site).href : '';
const ogUrl = site ? new URL(Astro.url.pathname, site).href : '';
const ogImageUrl = site
  ? new URL(asset(ogImageSrc).replace(/^\//, ''), site).href
  : asset(ogImageSrc);
const themeColor = view === 'me' ? '#f8ebf0' : '#12142a';
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{title}</title>
  <meta name="author" content={config.author || config.name}>
  {description && <meta name="description" content={description}>}
  {canonical && <link rel="canonical" href={canonical}>}
  <meta name="theme-color" content={themeColor}>

  <!--
    主题：在 CSS 之前就把 data-theme 写到 <html> 上。
    ⚠ 必须同步执行、而且必须在这里（样式表之前）：
      等 DOMContentLoaded 再设的话，浏览器会先按默认的深藏青画一帧、
      再跳到 SYNAPSE 的深空黑 —— 每次刷新都"闪一下"。
    也支持 ?theme=synapse / ?theme=kisara 直接进，进完会把参数从地址里去掉，
    并记进 localStorage（之后点顶栏按钮切换时才不会跟地址栏打架）。
  -->
  <script is:inline>
    (function () {
      try {
        var t = null;
        try {
          var m = /[?&]theme=(kisara|synapse)\b/.exec(location.search);
          if (m) {
            t = m[1];
            try { localStorage.setItem('irinsho:theme', t); } catch (e) {}
            try {
              var u = new URL(location.href);
              u.searchParams.delete('theme');
              history.replaceState(null, '', u.pathname + u.search + u.hash);
            } catch (e) {}
          }
        } catch (e) {}
        if (t !== 'synapse' && t !== 'kisara') {
          try { t = localStorage.getItem('irinsho:theme'); } catch (e) {}
        }
        if (t !== 'synapse' && t !== 'kisara') return;

        var root = document.documentElement;
        root.setAttribute('data-theme', t);
        if (t === 'synapse') {
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', '#05070d');
        }
      } catch (e) { /* 隐私模式 / 老浏览器：用默认主题即可 */ }
    })();
  </script>

  <!--
    换页擦除的第二半：如果这一页是从上一条 .syn-wipe 里"钻出来"的，
    在首帧之前就把遮罩立起来（盖住），再由 Base 的脚本把它抽走。
    ⚠ 必须在这里同步执行：等 DOMContentLoaded 再建，会先闪一帧新页面。
  -->
  <script is:inline>
    (function () {
      try {
        if (sessionStorage.getItem('irinsho:wipe') !== '1') return;
        sessionStorage.removeItem('irinsho:wipe');
        var w = document.createElement('div');
        w.className = 'syn-wipe is-covering';
        w.setAttribute('aria-hidden', 'true');
        document.documentElement.appendChild(w);
        document.documentElement.dataset.synWipeIn = '1';
        /* 兜底：主脚本没跑到（报错 / 被拦截）也别把整页永远盖住 */
        setTimeout(function () {
          document.documentElement.dataset.synWipeIn = '';
          var el = document.querySelector('.syn-wipe');
          if (!el || !el.classList.contains('is-covering')) return;
          el.classList.remove('is-covering');
          el.classList.add('is-out');
        }, 2200);
      } catch (e) {}
    })();
  </script>

  <!-- 分享（Open Graph / Twitter Card）：微信 / QQ / Twitter / 搜索引擎 -->
  <meta property="og:site_name" content={config.name}>
  <meta property="og:title" content={ogTitle}>
  <meta property="og:description" content={ogDescription}>
  <meta property="og:type" content={ogType}>
  <meta property="og:locale" content="zh_CN">
  {ogUrl && <meta property="og:url" content={ogUrl}>}
  {ogImageUrl && <meta property="og:image" content={ogImageUrl}>}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={ogTitle}>
  <meta name="twitter:description" content={ogDescription}>
  {ogImageUrl && <meta name="twitter:image" content={ogImageUrl}>}

  <link rel="icon" href={asset('favicon.svg')}>
  <link rel="stylesheet" href={asset('assets/css/style.css')}>
  {/* 新增层：首页纸面段落 + 章节导航轨 + 字号/间距 token。
      必须在 style.css 之后 —— 它用到 style.css :root 里的 --paper-* / --radius。
      它只定义自己的选择器，不覆盖既有规则，所以加载顺序变了也不会打架。 */}
  <link rel="stylesheet" href={asset('assets/css/paper.css')}>
  {/* 液态玻璃层：全站效果由 glass.css 顶部那一个 --glass 变量推导 */}
  <link rel="stylesheet" href={asset('assets/css/glass.css')}>
  {/* 主题层：切换按钮 + SYNAPSE 皮肤。
      ⚠ 必须最后加载 —— 它要压过 glass.css 里那些写死玫红的玻璃层。
      默认主题下它只有顶栏那个切换按钮的样式生效。 */}
  <link rel="stylesheet" href={asset('assets/css/theme.css')}>
  <ClientRouter />
  <!--
    首屏之前先把存好的「液态浓度」写上去。
    ⚠ 必须放在这里（同步、不 defer）：
      如果在下面的 <script> 里等 DOMContentLoaded 才设 --glass，
      页面会先用 CSS 里的默认值画一帧、再跳到用户调好的值 ——
      表现就是每次刷新顶栏都"闪一下"。
  -->
  <script is:inline>
    (function () {
      try {
        var v = localStorage.getItem('irinsho:glass');
        if (v === null) return;
        var n = parseFloat(v);
        if (!isFinite(n)) return;
        n = Math.max(0, Math.min(1, n));
        document.documentElement.style.setProperty('--glass', String(n));
      } catch (e) { /* 隐私模式禁用 storage：用 CSS 默认值即可 */ }
    })();
  </script>
  <!-- 首屏之前先把「开了动效」标记写上，避免内容闪一下再消失 -->
  <script is:inline>
    (function () {
      try {
        var reduce = window.matchMedia &&
          window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce) return;
        document.documentElement.classList.add('js-motion');

        /* 开场标记：只有"真正的首页硬加载 + 用户允许动效 + 本次会话还没进过"
           才会加。

           ⚠ 会话记忆（sessionStorage）：
             不能每次刷新都重播一遍开场 —— 用户的原话是"怎么还加载第一张"。
             所以进入过一次就在本次标签页里记下，之后刷新 / 重新打开
             这个站的首页都直接进主页。
             换新标签页或关掉重开会重新播（那是"新的一次访问"）。
             ⚠ 用 try/catch 包住：隐私模式 / 某些内嵌浏览器会禁用 storage，
               读不到就当没进过 —— 最坏是多播一次开场，不影响打开。

           ⚠ 这个类是所有开场样式（纸、粒子、首屏延迟）的总开关：
             它没被加上，纸的 CSS 就永远停在 opacity:0 + visibility:hidden，
             首屏元素也不会有任何延迟 —— 页面就是一个普通的静态首页。 */
        var p = location.pathname;
        var isHome = p === '/' || p === '' || /\/index\.html$/.test(p);
        if (!isHome) return;

        /* ⚠ 已经带上开场类了就别动 —— 这段脚本可能被执行多次
           （Astro 换页 / 缓存恢复），重复执行时必须保持幂等，
           否则会把"正在播的开场"改成"已进入"，纸当场消失。 */
        var cl = document.documentElement.classList;
        if (cl.contains('u-opening') || cl.contains('u-entered')) return;

        /* 会话记忆：进过一次就不再重播开场。
           ⚠ 这里必须用**客户端**存储：整个站是预渲染的
             （astro.config 没开 SSR），<html> 在构建时就定死了，
             服务器读不到请求头 —— cookie 方案试过，永远拿不到值。
           cookie 和 sessionStorage 都查一遍，任何一个命中就算进过。 */
        var entered = false;
        try {
          entered = (document.cookie.indexOf('irinsho_entered=1') !== -1) ||
                    (sessionStorage.getItem('irinsho:entered') === '1');
        } catch (e) {}

        /* ?force=1 用来强制重播（自己调试开场时方便，不影响正常访问） */
        if (/[?&]force=1/.test(location.search)) entered = false;

        if (entered) {
          // 本次会话已经进过：直接给"已进入"状态，开场整套跳过
          cl.add('u-entered');
        } else {
          cl.add('u-opening');
        }
      } catch (e) { /* 忽略：没有开场也要能正常打开 */ }
    })();
  </script>
</head>
<body data-view={view}>

{isHome && <Opening name={name} subtitle={config.homeMotto} folio={`${viewLabel} / ${brandNo} \u00b7 IRINSHO.TOP`} />}

<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" href={asset('')}>
      <span class="brand-mark">◆</span>
      <span class="brand-text">
        <b>{nameBefore}{accent && <em>{accent}</em>}{nameAfter}</b>
        <i class="brand-sub">{viewLabel} / {brandNo}</i>
      </span>
    </a>

    <nav class="tabs" id="navTabs" aria-label="主导航">
      {NAV.map((item) => (
        <a class={'tab' + (item.key === view ? ' active' : '')} href={asset(item.href)}>
          <span class="tab-no">{item.no}</span>
          <svg viewBox="0 0 24 24" set:html={ICONS[item.key]} />
          {item.label}
        </a>
      ))}
    </nav>

    <div class="topbar-actions">
      {/* 视觉主题切换：KISARA（现在的深蓝玫红）⇄ SYNAPSE（深空青紫）。
          文字写的是「点下去会切到哪」，状态由 <html data-theme> 决定，
          选择存在 localStorage，刷新 / 换页都保持。 */}
      <button
        type="button"
        class="theme-btn"
        id="themeToggle"
        aria-label="切换视觉主题"
        aria-pressed="false"
        title="切换视觉主题"
      >
        <span class="theme-glyph" aria-hidden="true">◈</span>
        <span class="theme-label">SYNAPSE</span>
      </button>

      <a class="avatar-btn" href={asset('me/')} title="个人档案">
        <img src={asset(config.avatar)} alt="头像" onerror="this.classList.add('is-broken')">
      </a>
      <button class="icon-btn menu-btn" id="menuToggle" title="菜单" aria-label="菜单">☰</button>
    </div>
  </div>
</header>

<main id="main">
  {hero && (
    <Gate
      eyebrow={heroKicker}
      title={hero}
      sub={heroSub}
      image={heroImage || 'media/images/home-hero.webp'}
    />
  )}
  <slot />
</main>

<footer class="footer">
  <span>{footerText}</span>
  {/* 液态浓度入口：点开调参面板（等价于 ?tune=glass / Ctrl+Shift+G） */}
  <button type="button" class="glass-open" id="glassOpen" title="调节液态玻璃浓度">液态浓度</button>
</footer>

{/*
  自定义右键菜单（对齐参考站 .kisara-context-menu）
  ---------------------------------------------------------
  三条刻意的克制，避免变成"网站抢了浏览器的手"：
    ① 只在「精确指针」设备上启用（触屏 / 电视不拦）
    ② 在链接、按钮、图片、输入框、视频上**不拦** —— 那些地方
       用户往往就是要用原生菜单（另存图片、复制链接、检查元素）
    ③ 按住 Shift + 右键永远出原生菜单
  菜单本身是普通链接 + 两个按钮，键盘 Tab / Esc 都能用。
*/}
<div class="ctxmenu" id="ctxMenu" role="menu" aria-hidden="true" aria-label="快捷菜单">
  <p class="ctxmenu-head">QUICK ROUTE</p>
  <a role="menuitem" href={asset('')}><span>首页</span><kbd>01</kbd></a>
  <a role="menuitem" href={asset('photos/')}><span>相册</span><kbd>02</kbd></a>
  <a role="menuitem" href={asset('videos/')}><span>影像</span><kbd>03</kbd></a>
  <a role="menuitem" href={asset('notes/')}><span>笔记</span><kbd>04</kbd></a>
  <a role="menuitem" href={asset('me/')}><span>个人档案</span><kbd>05</kbd></a>
  <div class="ctxmenu-sep" role="separator"></div>
  <button type="button" role="menuitem" data-ctx="top"><span>回到顶部</span><kbd>↑</kbd></button>
  <button type="button" role="menuitem" data-ctx="copy"><span>复制本页链接</span><kbd>C</kbd></button>
</div>

{/*
  液态浓度调节面板
  ---------------------------------------------------------
  这是给**站主调参**用的，访客平时看不到：
    · 打开方式一：网址后面加 ?tune=glass
    · 打开方式二：Ctrl / ⌘ + Shift + G
  调好后点「复制 --glass 值」，把那一行贴回 glass.css 顶部，
    就变成了全站的默认浓度（面板里改的只是本机 localStorage）。
*/}
<div class="gt" id="glassTuner" role="dialog" aria-label="液态浓度调节" aria-hidden="true">
  <div class="gt-head">
    <b>LIQUID GLASS</b>
    <span id="gtValue">62%</span>
    <button type="button" class="gt-close" id="gtClose" aria-label="关闭" title="关闭">✕</button>
  </div>

  <input
    type="range"
    id="gtRange"
    min="0"
    max="100"
    step="1"
    value="62"
    aria-label="液态浓度"
  />

  <div class="gt-presets" id="gtPresets">
    <button type="button" data-g="0">实体</button>
    <button type="button" data-g="0.35">轻</button>
    <button type="button" data-g="0.62">标准</button>
    <button type="button" data-g="0.85">浓</button>
    <button type="button" data-g="1">极浓</button>
  </div>

  <button type="button" class="gt-css" id="gtCopy">复制 --glass 值</button>
  <p class="gt-hint">
    贴回 <code>glass.css</code> 顶部就是全站默认浓度。当前改动只存在这台浏览器里。
  </p>
</div>

<script>
  /* 窄屏的下拉菜单 —— 必须是「可重复调用且幂等」的：
     开了页面过渡后脚本会在 DOMContentLoaded 和 astro:page-load 各跑一次，
     如果这里直接 addEventListener，就会挂上两个 click，
     一次点击被 toggle 两下（开→关）——表现就是"只有第一次点得动"。
     所以用 dataset.menuBound 挡住重复绑定。 */
  function initMenu() {
    const menuBtn = document.getElementById('menuToggle');
    const tabs = document.querySelector('.tabs');
    if (!menuBtn || !tabs || menuBtn.dataset.menuBound === '1') return;
    menuBtn.dataset.menuBound = '1';

    menuBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      tabs.classList.toggle('open');
    });
    document.addEventListener('click', (e) => {
      if (!e.target.closest('.tabs') && !e.target.closest('#menuToggle')) {
        tabs.classList.remove('open');
      }
    });
  }

  /* =========================================================
   *  ① 滚动进度（替代原来的 IntersectionObserver 浮现）
   *  ---------------------------------------------------------
   *  参考站 yuimi-chaya.github.io（Kisara 主题）在四个首页 CSS 里
   *  `IntersectionObserver` / `is-visible` / `is-in` 全部是 **0 次**。
   *  它只有一套东西：**滚动进度 → CSS 变量 → 形态**（页面底部就写着
   *  "SCROLL = FRAME / STOP = HOLD"）。所有引用都是 var(--kisara-*)。
   *
   *  所以这里不再给每个卡片挂 observer、加 .is-in、错峰 55ms ——
   *  那套的问题：每块内容各自决定"我什么时候浮出来"，
   *  一页长笔记往下滑会不停地有东西在动，视觉上很吵；
   *  而且每次换页都要重新注册一批 observer。
   *
   *  现在只算两个数，写进 <html>：
   *    --scroll-y     已经滚过多少 px（连续）
   *    --scroll-progress  0~1（整页进度，顶栏那条进度轨也用它）
   *  形态交给 CSS（见 style.css「滚动进度」那一段）。
   *  默认页面完全可见 —— 这段脚本只负责写变量，挂了也不影响可读性。
   * ======================================================= */
  const prefersReduced = window.matchMedia &&
    window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function startScrollProgress() {
    try {
      if (prefersReduced) return;
      const root = document.documentElement;
      if (root.dataset.scrollProgress === '1') return;   // 幂等
      root.dataset.scrollProgress = '1';

      let ticking = false;

      function write() {
        ticking = false;
        const y = window.scrollY || 0;
        const total = Math.max(1, root.scrollHeight - window.innerHeight);
        root.style.setProperty('--scroll-y', y.toFixed(1) + 'px');
        root.style.setProperty('--scroll-progress', Math.min(1, y / total).toFixed(4));
      }

      window.addEventListener('scroll', () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(write);
      }, { passive: true });
      window.addEventListener('resize', write, { passive: true });

      write();
    } catch (e) { /* 只是优化，出错不影响页面 */ }
  }

  /* =========================================================
   *  ② 自定义鼠标：**已删除**
   *  ---------------------------------------------------------
   *  参考站 yuimi-chaya.github.io（Kisara 主题）的做法是彻底不要：
   *  在它四个首页 CSS 里 `cursor: none` 出现 0 次。
   *
   *  删掉的理由（也是用户的原话"不跟手、看着廉价"）：
   *    · 它把系统光标换成一个 26px 的圈，圈永远比指针慢一点点 ——
   *      操作系统的光标是零延迟的，任何自定义光标都赢不了
   *    · 圈会跟着指针在链接、卡片上放大/变色/显示 OPEN，
   *      等于满屏都在提示"这里可以点"，抢掉了内容本身的注意力
   *    · 一圈毛玻璃(backdrop-filter) + 磁吸偏移，每帧都要重算
   *  现在系统光标回来了：指针在哪就是哪，最跟手。
   *  （CSS 里的 .cur-* / html.has-cursor 规则也一并删掉了，
   *    所以即使有旧缓存里的 DOM 残留也不会隐藏光标。）
   * ======================================================= */

  /* =========================================================
   *  ③ 导航栏动效
   *  · 鼠标在导航上时，一条玫红指示条会跟着光标滑动
   *  · 点击后立刻把指示条挪到目标位置，换页不闪
   * ======================================================= */
  function startNavIndicator() {
    const nav = document.getElementById('navTabs');
    if (!nav || prefersReduced) return;

    let bar = nav.querySelector('.nav-ind');
    if (!bar) {
      bar = document.createElement('span');
      bar.className = 'nav-ind';
      bar.setAttribute('aria-hidden', 'true');
      nav.appendChild(bar);
    }

    const active = nav.querySelector('.tab.active');
    const moveTo = (el, instant) => {
      if (!el) return;
      const nb = nav.getBoundingClientRect();
      const eb = el.getBoundingClientRect();
      bar.style.width = eb.width + 'px';
      bar.style.transform = `translateX(${eb.left - nb.left}px)`;
      bar.classList.toggle('is-instant', !!instant);
      requestAnimationFrame(() => bar.classList.remove('is-instant'));
      bar.classList.add('is-on');
    };

    // 初始位置（等字体排好，避免宽度量错）
    const start = () => moveTo(active || nav.querySelector('.tab'), true);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(start);
    else setTimeout(start, 120);

    nav.addEventListener('mouseover', (e) => {
      const t = e.target.closest('.tab');
      if (t) moveTo(t);
    });
    nav.addEventListener('mouseleave', () => moveTo(active, true));
    nav.addEventListener('click', (e) => {
      const t = e.target.closest('.tab');
      if (t) moveTo(t, true);
    });
    window.addEventListener('resize', () => moveTo(active, true), { passive: true });
  }

  /* =========================================================
   *  ⑤ 卡片 3D 倾斜 + 光晕跟随：**已删除**
   *  ⑥ 点击涟漪 + 粒子爆发：**已删除**
   *  ---------------------------------------------------------
   *  参考站 yuimi-chaya.github.io（Kisara 主题）在四个首页 CSS 里：
   *    · `perspective(` / `rotateX(` → 0 次（没有卡片 3D 倾斜）
   *    · 点击涟漪 / 粒子爆发 → 完全没有
   *  它卡片唯一的悬停反馈是 `transition: border-color .16s ease-out`。
   *
   *  删掉的理由：
   *    · 3D 倾斜 + 光晕让每张卡片都在"自己动"，一屏五张卡就是五份注意力；
   *      而且倾斜会和 html.reveal 的浮现位移抢同一个 transform
   *    · 点击涟漪在每次点链接/导航时都炸一圈玫红，跟页面切换抢戏；
   *      粒子爆发只在带 data-burst 的元素上，属于"会玩"不是"好看"
   *  现在卡片的悬停反馈改成纯 CSS 的轻微上浮 + 描边变色（见 style.css
   *  的「卡片悬停」那一段），静止时整页是静的。
   * ======================================================= */

  /* =========================================================
   *  ⑦ 滚动状态标记（全站一处，供 CSS 使用）
   *  ---------------------------------------------------------
   *  页面上很多过渡是"慢工出细活"型的（浮现 0.68s、卡片 0.32s…），
   *  静止时它们很舒服，**滚动时**却会拖住整个画面：
   *  过渡要花 0.68s 去追一个一直在变的滚动位置，看起来就是发飘、跟手差。
   *
   *  所以这里只做一件事：滚动期间给 <html> 打上 data-scrolling，
   *  停下 160ms 后摘掉。style.css 里用
   *  `html.reveal[data-scrolling] …` 把过渡时长归零 ——
   *  滚的时候干脆利落，停下来该有的淡入一点都不少。
   *
   *  只在这里维护这一个标记：以前分散在 index.astro / Gate.astro 各写一份，
   *  两个 setTimeout 会互相踩，标记忽有忽无。
   * ======================================================= */

  function startScrollFlag() {
    try {
      if (prefersReduced) return;
      if (document.documentElement.dataset.scrollFlag === '1') return;   // 幂等
      document.documentElement.dataset.scrollFlag = '1';

      const IDLE = 160;
      let timer = 0;

      window.addEventListener('scroll', () => {
        document.documentElement.dataset.scrolling = '1';
        clearTimeout(timer);
        timer = setTimeout(() => {
          delete document.documentElement.dataset.scrolling;
        }, IDLE);
      }, { passive: true });
    } catch (e) { /* 忽略：这只是优化，出错不影响别处 */ }
  }

  /* =========================================================
   *  ⑦ 自定义右键菜单
   *  ---------------------------------------------------------
   *  参考站 yuimi-chaya.github.io 有一份 .kisara-context-menu。
   *  这里做一版**不抢浏览器手**的：
   *    · 只在 hover:hover + pointer:fine（真正的鼠标）上启用
   *    · 链接 / 按钮 / 图片 / 输入框 / 视频上完全不拦
   *    · Shift + 右键 = 原生菜单（取图、检查元素都还在）
   *    · Esc / 点别处 / 滚动 / 换页 都会关掉
   *  所有绑定都挂在 document 上并做幂等，换页重建 DOM 也不会重复绑。
   * ======================================================= */
  function initContextMenu() {
    try {
      const menu = document.getElementById('ctxMenu');
      if (!menu || menu.dataset.ctxBound === '1') return;
      menu.dataset.ctxBound = '1';

      // 触屏 / 没有精确指针：直接不启用（否则长按会莫名其妙弹菜单）
      if (!window.matchMedia ||
          !window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        menu.remove();
        return;
      }

      const NO_INTERCEPT = 'a, button, input, textarea, select, video, audio, [contenteditable], label';
      let isOpen = false;

      const close = () => {
        if (!isOpen) return;
        isOpen = false;
        menu.classList.remove('is-open');
        menu.setAttribute('aria-hidden', 'true');
      };

      const place = (x, y) => {
        // 先归零再量：不归零的话上一帧的 translate 会参与 getBoundingClientRect
        menu.style.left = '0px';
        menu.style.top = '0px';
        const r = menu.getBoundingClientRect();
        const left = Math.max(12, Math.min(x, window.innerWidth - r.width - 12));
        const top = Math.max(12, Math.min(y, window.innerHeight - r.height - 12));
        menu.style.left = left + 'px';
        menu.style.top = top + 'px';
      };

      document.addEventListener('contextmenu', (e) => {
        if (e.shiftKey) return;                       // 留给浏览器
        const t = e.target;
        if (!t || !t.closest) return;
        if (t.closest(NO_INTERCEPT)) return;          // 留给浏览器
        e.preventDefault();
        isOpen = true;
        menu.classList.add('is-open');
        menu.setAttribute('aria-hidden', 'false');
        place(e.clientX, e.clientY);
      }, { passive: false });

      // 点菜单外部 / 滚动 / Esc → 关
      document.addEventListener('pointerdown', (e) => {
        if (isOpen && !menu.contains(e.target)) close();
      }, { passive: true });
      window.addEventListener('scroll', close, { passive: true });
      window.addEventListener('resize', close, { passive: true });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && isOpen) close();
      });

      // 菜单里的动作
      menu.addEventListener('click', (e) => {
        const btn = e.target.closest('[data-ctx]');
        if (btn) {
          const act = btn.dataset.ctx;
          if (act === 'top') {
            close();
            try {
              const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
              window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
            } catch (err) { window.scrollTo(0, 0); }
          } else if (act === 'copy') {
            const done = () => {
              const label = btn.querySelector('span');
              if (!label) return;
              const old = label.textContent;
              label.textContent = '已复制';
              setTimeout(() => { label.textContent = old; }, 1400);
            };
            try {
              if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(location.href).then(done, () => {});
              }
            } catch (err) { /* 剪贴板被禁用就当没点 */ }
          }
          return;
        }
        // 点了菜单里的链接 → 立刻收起（换页后它还会在，但先关掉更利落）
        if (e.target.closest('a')) close();
      });

      // 换页前也收起来
      document.addEventListener('astro:before-swap', close);
    } catch (e) { /* 只是锦上添花，出错不影响别处 */ }
  }

  /* =========================================================
   *  ⑧ 液态浓度调节面板
   *  ---------------------------------------------------------
   *  全站玻璃效果只有一个旋钮：--glass（0–1，定义在 glass.css）。
   *  这里负责：
   *    · 拖动滑杆 → 立刻写 <html style="--glass:…"> → 全站跟着变
   *    · 存 localStorage，下次打开自动恢复（首帧由 head 里的内联脚本补上）
   *    · 「复制 --glass 值」复制成一行 CSS，贴回 glass.css 即成为站点默认
   *    · 打开：?tune=glass 或 Ctrl/⌘ + Shift + G
   *
   *  ⚠ 快捷键监听挂在 document 上，如果每次换页都注册一遍就会越积越多。
   *    所以用 <html> 上的标记确保只注册一次，并在触发时**重新查找**面板
   *    （换页后 DOM 是新的，闭包里那个旧引用已经没用了）。
   * ======================================================= */
  function initGlassTuner() {
    try {
      const root = document.documentElement;
      const box = document.getElementById('glassTuner');

      /* 快捷键只注册一次（与面板元素是否重建无关） */
      if (root.dataset.gtShortcut !== '1') {
        root.dataset.gtShortcut = '1';
        document.addEventListener('keydown', (e) => {
          if (!(e.ctrlKey || e.metaKey) || !e.shiftKey) return;
          if (e.key !== 'g' && e.key !== 'G') return;
          const el = document.getElementById('glassTuner');
          if (!el) return;
          e.preventDefault();
          el.classList.toggle('is-open');
          el.setAttribute('aria-hidden', el.classList.contains('is-open') ? 'false' : 'true');
        });
      }

      /* 页脚「液态浓度」入口：委托在 document 上，
         这样换页把按钮重建掉之后也不用重新绑定。 */
      if (root.dataset.gtOpenBound !== '1') {
        root.dataset.gtOpenBound = '1';
        document.addEventListener('click', (e) => {
          if (!e.target.closest || !e.target.closest('#glassOpen')) return;
          const el = document.getElementById('glassTuner');
          if (!el) return;
          el.classList.toggle('is-open');
          el.setAttribute('aria-hidden', el.classList.contains('is-open') ? 'false' : 'true');
        });
      }

      if (!box || box.dataset.gtBound === '1') return;
      box.dataset.gtBound = '1';
      const range = document.getElementById('gtRange');
      const valueEl = document.getElementById('gtValue');
      const presets = document.getElementById('gtPresets');
      const copyBtn = document.getElementById('gtCopy');
      const closeBtn = document.getElementById('gtClose');
      if (!range || !valueEl) return;

      const current = () => {
        const v = parseFloat(getComputedStyle(root).getPropertyValue('--glass'));
        return isFinite(v) ? Math.max(0, Math.min(1, v)) : 0.62;
      };

      const paint = (v) => {
        const pct = Math.round(v * 100);
        valueEl.textContent = pct + '%';
        if (String(range.value) !== String(pct)) range.value = String(pct);
        range.style.setProperty('--fill', pct + '%');
        if (presets) {
          presets.querySelectorAll('button[data-g]').forEach((b) => {
            const g = parseFloat(b.dataset.g);
            b.classList.toggle('is-on', isFinite(g) && Math.abs(g - v) < 0.005);
          });
        }
      };

      const apply = (v, save) => {
        const n = Math.max(0, Math.min(1, v));
        root.style.setProperty('--glass', n.toFixed(2));
        paint(n);
        if (save) {
          try { localStorage.setItem('irinsho:glass', n.toFixed(2)); } catch (err) {}
        }
      };

      /* 进来先对齐：当前值可能来自 localStorage，也可能是 glass.css 的默认 */
      paint(current());

      range.addEventListener('input', () => apply(Number(range.value) / 100, true));

      if (presets) {
        presets.addEventListener('click', (e) => {
          const btn = e.target.closest('button[data-g]');
          if (btn) apply(parseFloat(btn.dataset.g), true);
        });
      }

      if (copyBtn) {
        copyBtn.addEventListener('click', () => {
          const line = `--glass: ${current().toFixed(2)};`;
          const done = () => {
            const old = copyBtn.textContent;
            copyBtn.textContent = '已复制  ' + line;
            setTimeout(() => { copyBtn.textContent = old; }, 1800);
          };
          try {
            navigator.clipboard.writeText(line).then(done, () => {});
          } catch (err) { /* 剪贴板被禁用就只当没点 */ }
        });
      }

      const open = () => {
        box.classList.add('is-open');
        box.setAttribute('aria-hidden', 'false');
        paint(current());
        try { range.focus({ preventScroll: true }); } catch (err) {}
      };
      const close = () => {
        box.classList.remove('is-open');
        box.setAttribute('aria-hidden', 'true');
      };

      if (closeBtn) closeBtn.addEventListener('click', close);
      box.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });

      /* ?tune=glass 直接打开，省得每次记快捷键 */
      try {
        if (/[?&]tune=glass\b/.test(location.search)) open();
      } catch (err) { /* 某些内嵌浏览器拿不到 location.search */ }
    } catch (e) { /* 调参面板坏掉也不影响站点本身 */ }
  }

  /* =========================================================
   *  ⑨ 主题切换（KISARA ⇄ SYNAPSE）
   *  ---------------------------------------------------------
   *  · 顶栏按钮只管一件事：把 <html data-theme> 换成另一套，
   *    并把选择写进 localStorage 的 irinsho:theme
   *  · 首帧是 <head> 里那段内联脚本负责的（见那里），这里只补两件事：
   *      换页后 <html> 的属性会被 Astro 重置 → 按存储值补回来
   *      另一个标签页改了主题 → 这一页跟着换
   *  · 幂等：astro:page-load 每次都会调 initTheme，
   *    按钮绑定靠 dataset 挡重复，全局监听靠 window 上的标记只挂一次
   * ======================================================= */
  const THEME_KEY = 'irinsho:theme';

  function readTheme() {
    try {
      const v = localStorage.getItem(THEME_KEY);
      if (v === 'synapse' || v === 'kisara') return v;
    } catch (e) {}
    return document.documentElement.getAttribute('data-theme') === 'synapse'
      ? 'synapse'
      : 'kisara';
  }

  /* 手机浏览器地址栏 / 状态栏的颜色也跟着主题走 */
  function paintThemeMeta(t) {
    const meta = document.querySelector('meta[name="theme-color"]');
    if (!meta) return;
    const isMe = document.body && document.body.dataset.view === 'me';
    meta.setAttribute('content',
      t === 'synapse' ? '#05070d' : (isMe ? '#f8ebf0' : '#12142a'));
  }

  /* 按钮上写的是「点下去会切到哪」，读屏软件读的是当前主题 + 动作 */
  function paintThemeButton() {
    const btn = document.getElementById('themeToggle');
    if (!btn) return;
    const t = readTheme();
    const other = t === 'synapse' ? 'KISARA' : 'SYNAPSE';
    const now = t === 'synapse' ? 'SYNAPSE' : 'KISARA';
    const label = btn.querySelector('.theme-label');
    if (label) label.textContent = other;
    btn.setAttribute('aria-pressed', t === 'synapse' ? 'true' : 'false');
    btn.setAttribute('aria-label', '视觉主题：' + now + '，点击切换到 ' + other);
    btn.title = '视觉主题：' + now + ' → ' + other;
  }

  function applyTheme(t, persist) {
    const root = document.documentElement;
    root.setAttribute('data-theme', t === 'synapse' ? 'synapse' : 'kisara');
    if (persist) {
      try { localStorage.setItem(THEME_KEY, t); } catch (e) {}
    }
    paintThemeMeta(t);
    paintThemeButton();

    /* 只在这 0.46s 里允许背景 / 文字做颜色过渡，
       平时不要它 —— 否则别处的悬停变色会被拖慢 */
    root.classList.add('theme-swap');
    clearTimeout(applyTheme._swapTimer);
    applyTheme._swapTimer = setTimeout(() => root.classList.remove('theme-swap'), 460);

    try {
      window.dispatchEvent(new CustomEvent('irinsho:theme', { detail: { theme: t } }));
    } catch (e) {}
  }

  function initTheme() {
    const root = document.documentElement;

    /* 换页会替换 <html> 的属性，按存储值补回来（不写回 storage） */
    const t = readTheme();
    if (root.getAttribute('data-theme') !== t) root.setAttribute('data-theme', t);
    paintThemeMeta(t);
    paintThemeButton();

    if (!window.__irinshoThemeSync) {
      window.__irinshoThemeSync = true;

      /* 换页过渡：先把新文档的 <html> 标好。
         不标的话，新页面会先按默认主题画一帧，颜色跳一下。 */
      document.addEventListener('astro:before-swap', (e) => {
        try {
          const next = readTheme();
          if (e.newDocument && e.newDocument.documentElement) {
            e.newDocument.documentElement.setAttribute('data-theme', next);
          }
        } catch (err) {}
      });

      /* 同一浏览器开了多个标签页时，一处切换、处处跟着换 */
      window.addEventListener('storage', (e) => {
        if (e.key !== THEME_KEY) return;
        applyTheme(e.newValue === 'synapse' ? 'synapse' : 'kisara', false);
      });
    }

    const btn = document.getElementById('themeToggle');
    if (btn && btn.dataset.themeBound !== '1') {
      btn.dataset.themeBound = '1';
      btn.addEventListener('click', () => {
        applyTheme(readTheme() === 'synapse' ? 'kisara' : 'synapse', true);
      });
    }
  }

  /* =========================================================
   *  ⑩ 路由切换：整屏圆角面板擦除（仅 SYNAPSE）
   *  ---------------------------------------------------------
   *  · 点击链接 → before-preparation：一块紫色圆角面板从下方盖住
   *  · 新页面换好 → after-swap：等它盖满，再向上抽走露出新页
   *  · 挂在 <html> 上的 div：Astro 换的是 body，这块不会被清掉
   *  · 顶栏 z-index 比它高，所以导航全程不动（对齐参考站）
   *  · 减少动效 / KISARA / 链接下载失败（2.5s 兜底）都会跳过
   * ======================================================= */
  function initSynWipe() {
    if (window.__synWipeBound) return;
    window.__synWipeBound = true;

    const reduced = () => window.matchMedia &&
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const ensure = () => {
      let el = document.querySelector('.syn-wipe');
      if (!el) {
        el = document.createElement('div');
        el.className = 'syn-wipe';
        el.setAttribute('aria-hidden', 'true');
        document.documentElement.appendChild(el);
      }
      return el;
    };

    /* 这一页是被上一条遮罩带进来的：首帧已经盖住，这里只负责抽走 */
    const pending = document.documentElement.dataset.synWipeIn === '1';
    if (pending) {
      delete document.documentElement.dataset.synWipeIn;
      const el = ensure();
      el.classList.add('is-covering');
      requestAnimationFrame(() => requestAnimationFrame(() => {
        el.classList.remove('is-covering');
        el.classList.add('is-out');
      }));
    }

    /* 点击拦截：走整页跳转（绕开 Astro 的 View Transition 顶层快照，
       否则快照会盖在遮罩上面，出现导航重影），旧页先被紫色面板盖住。 */
    document.addEventListener('click', (e) => {
      if (document.documentElement.getAttribute('data-theme') !== 'synapse') return;
      if (reduced()) return;
      if (e.defaultPrevented || e.button !== 0) return;
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;

      const a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
      if (!a) return;
      if (a.target === '_blank' || a.hasAttribute('download')) return;

      const href = a.getAttribute('href');
      if (!href || href.charAt(0) === '#') return;

      let url;
      try { url = new URL(a.href, location.href); } catch (err) { return; }
      if (url.origin !== location.origin) return;
      if (url.pathname === location.pathname && url.search === location.search) return;

      e.preventDefault();
      e.stopImmediatePropagation();

      try { sessionStorage.setItem('irinsho:wipe', '1'); } catch (err) {}

      const el = ensure();
      el.classList.remove('is-out');
      el.classList.remove('is-covering');
      void el.offsetWidth;
      el.classList.add('is-covering');

      window.setTimeout(() => { location.href = url.href; }, 260);
    }, true);
  }

  /* =========================================================
   *  ④ 换页后重启
   *  ---------------------------------------------------------
   *  开了页面过渡（ClientRouter）后，Astro 换页时会把旧 DOM 整个换掉。
   *  astro:page-load 在「首次加载」和「每次换页完成」都会触发，
   *  所以把需要跟着换页走的东西挂到它上面。
   *  所有初始化函数内部都有幂等保护，重复调用安全。
   *
   *  ⚠ 现在这里只剩三件事，都是"全站一次性"的：
   *    initMenu          窄屏下拉菜单（绑在被换掉的 DOM 上）
   *    startNavIndicator 顶栏指示条宽度要按新页面重新量
   *    startScrollProgress / startScrollFlag  幂等，重复调用直接返回
   *  （光标、卡片倾斜、点击特效都已经按参考站的做法删掉了；
   *    滚动浮现改成 CSS 变量驱动，不需要每次换页重新注册。）
   * ======================================================= */
  function bootMotion() {
    /* ⚠ 这里**不再自行决定**开场状态 —— 那是 head 里内联脚本的事
       （见 <head> 里那段长注释）。之前这里也改 class，两处互踩，
       实测出现过"开场还没播就被改成已进入、纸当场消失"。

       这里只做一件必要的事：客户端换页会替换 <html> 的 class 属性，
       所以换页到首页时补上 u-entered（不重播开场，文字立即可见），
       并清掉可能残留的开场层与滚动锁。 */
    try {
      const root = document.documentElement;

      /* 客户端换页会替换 <html> 的 class 属性，head 里那两件事都得补回来：
           · js-motion —— 控制顶栏下滑、进度条等入场动画（少了它内页就没入场）
           · u-entered  —— 换页到首页时标记"已进入"，不重播开场 */
      if (window.matchMedia &&
          !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        root.classList.add('js-motion');
      }

      const p = location.pathname;
      const isHome = p === '/' || p === '' || /\/index\.html$/.test(p);
      if (isHome && !root.classList.contains('u-opening')) root.classList.add('u-entered');
      if (!isHome) root.classList.remove('u-entered', 'u-opening');
      root.style.removeProperty('overflow');   // 别把开场的滚动锁留在新页面上
    } catch (e) { /* 忽略 */ }

    /* 开场没在播时，那张纸不该留在 DOM 里（换页会重新生成一份） */
    try {
      if (!document.documentElement.classList.contains('u-opening')) {
        document.querySelectorAll('.opening').forEach((el) => el.remove());
      }
    } catch (e) { /* 忽略 */ }

    initMenu();
    startNavIndicator();
    startScrollProgress();
    startScrollFlag();
    initContextMenu();
    initGlassTuner();
    initTheme();
    initSynWipe();
  }

  document.addEventListener('astro:page-load', bootMotion);

  // 没启用页面过渡时的兜底（此时只有一次 DOMContentLoaded）
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bootMotion);
  } else {
    bootMotion();
  }
</script>

</body>
</html>
