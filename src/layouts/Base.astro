---
import config from '../data/config.js';
import { asset } from '../lib/url.js';

const { title = config.name, description = '' } = Astro.props;

// 当前在哪个板块（用于 body 的属性，个人页整页换浅粉底色）
const path = Astro.url.pathname;
const view = path === '/' || path === ''
  ? 'home'
  : /^\/photos/.test(path) ? 'photos'
  : /^\/videos/.test(path) ? 'videos'
  : /^\/notes/.test(path) ? 'notes'
  : /^\/me/.test(path) ? 'me'
  : 'home';

const ICONS = {
  home: '<path d="M3 10.5 12 3l9 7.5"/><path d="M5.8 9.2V20h12.4V9.2"/>',
  photos: '<rect x="3" y="4.5" width="18" height="15" rx="2"/><circle cx="8.6" cy="9.6" r="1.5"/><path d="m4 17.5 5-5 4 4 3-2.5 4 3.5"/>',
  videos: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m10.5 9.2 5 2.8-5 2.8z"/>',
  notes: '<path d="M6.5 3h8L19 7.5V21H6.5z"/><path d="M14.5 3v4.5H19"/><path d="M9.5 12.5h6M9.5 16h6"/>',
  me: '<circle cx="12" cy="8.6" r="3.6"/><path d="M5 20.5c0-3.9 3.1-6.6 7-6.6s7 2.7 7 6.6"/>'
};

const NAV = [
  { key: 'home', href: '/', label: 'HOME', no: '01' },
  { key: 'photos', href: '/photos/', label: 'GALLERY', no: '02' },
  { key: 'videos', href: '/videos/', label: 'VIDEO', no: '03' },
  { key: 'notes', href: '/notes/', label: 'BLOG', no: '04' },
  { key: 'me', href: '/me/', label: 'ME', no: '05' }
];

// 顶栏左侧品牌：编号 = 当前板块在导航里的序号（Kisara 那种「KISARA / 03」的味道）
const currentIndex = Math.max(0, NAV.findIndex((n) => n.key === view));
const brandNo = String(currentIndex + 1).padStart(2, '0');
const viewLabel = (NAV[currentIndex] && NAV[currentIndex].label) || 'HOME';

// 品牌名分色
const name = config.name || '';
const accent = config.nameAccent || '';
const ai = accent ? name.indexOf(accent) : -1;
const nameBefore = ai >= 0 ? name.slice(0, ai) : name;
const nameAfter = ai >= 0 ? name.slice(ai + accent.length) : '';

const year = new Date().getFullYear();
const footerRaw = String(config.footer || '');
// 页脚里写了 {year} 就替换成当前年份；没写就原样显示
const footerText = footerRaw.includes('{year}')
  ? footerRaw.replace(/\{year\}/g, year)
  : footerRaw;
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{title}</title>
  <meta name="author" content={config.author || config.name}>
  {description && <meta name="description" content={description}>}
  <link rel="icon" href={asset('favicon.svg')}>
  <link rel="stylesheet" href={asset('assets/css/style.css')}>
</head>
<body data-view={view}>

<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" href={asset('')}>
      <span class="brand-mark">◆</span>
      <span class="brand-text">
        <b>{nameBefore}{accent && <em>{accent}</em>}{nameAfter}</b>
        <i class="brand-sub">{viewLabel} / {brandNo}</i>
      </span>
    </a>

    <nav class="tabs" id="navTabs" aria-label="主导航">
      {NAV.map((item) => (
        <a class={'tab' + (item.key === view ? ' active' : '')} href={asset(item.href)}>
          <span class="tab-no">{item.no}</span>
          <svg viewBox="0 0 24 24" set:html={ICONS[item.key]} />
          {item.label}
        </a>
      ))}
    </nav>

    <div class="topbar-actions">
      <a class="avatar-btn" href={asset('me/')} title="个人档案">
        <img src={asset(config.avatar)} alt="头像" onerror="this.classList.add('is-broken')">
      </a>
      <button class="icon-btn menu-btn" id="menuToggle" title="菜单" aria-label="菜单">☰</button>
    </div>
  </div>
</header>

<main id="main">
  <slot />
</main>

<footer class="footer">
  <span>{footerText}</span>
</footer>

<script>
  // 窄屏的下拉菜单
  const menuBtn = document.getElementById('menuToggle');
  const tabs = document.querySelector('.tabs');
  if (menuBtn && tabs) {
    menuBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      tabs.classList.toggle('open');
    });
    document.addEventListener('click', (e) => {
      if (!e.target.closest('.tabs') && !e.target.closest('#menuToggle')) {
        tabs.classList.remove('open');
      }
    });
  }

  /* =========================================================
   *  ① 滚动浮现动效（IntersectionObserver 驱动）
   *  ---------------------------------------------------------
   *  为什么不用纯 CSS animation：
   *    纯 CSS 的入场动画只在「页面加载那一刻」播一次，加载完就没了，
   *    而且一旦被浏览器缓存 / 系统开了「减少动态效果」就完全看不到。
   *    这里改成：默认全部可见（JS 挂了也不会白屏），
   *    只有脚本正常运行时才加 .reveal，然后**滚到哪块、哪块才浮现** ——
   *    一页长笔记滑下去会不断有内容浮出来，看得见、也更耐看。
   * ======================================================= */
  const prefersReduced = window.matchMedia &&
    window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReduced) {
    document.documentElement.classList.add('reveal');

    const targets = document.querySelectorAll(
      '.markdown > *, .post-bar, .post, .gallery-item, .video-card, .panel'
    );

    if ('IntersectionObserver' in window && targets.length) {
      const io = new IntersectionObserver((entries) => {
        for (const en of entries) {
          if (!en.isIntersecting) continue;
          en.target.classList.add('is-in');
          io.unobserve(en.target);
        }
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.06 });

      targets.forEach((el, i) => {
        // 同一屏内依次错开一点点，像涟漪一样浮上来
        el.style.setProperty('--reveal-delay', (i % 8) * 55 + 'ms');
        io.observe(el);
      });
    } else {
      targets.forEach((el) => el.classList.add('is-in'));
    }
  }

  /* =========================================================
   *  ② 自定义鼠标（一个跟随的点 + 一个带阻尼的圈）
   *  ---------------------------------------------------------
   *  · 只在「有真实鼠标」的设备上启用（触屏手机不动它）
   *  · 只有脚本跑起来、点/圈都建好了，才隐藏系统光标
   *    （否则脚本一挂用户就没光标了，那是灾难）
   *  · 悬停在链接/按钮/卡片上时：圈会放大、变色，出现提示
   * ======================================================= */
  const finePointer = window.matchMedia &&
    window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  if (finePointer && !prefersReduced) {
    const dot = document.createElement('div');
    dot.className = 'cur-dot';
    const ring = document.createElement('div');
    ring.className = 'cur-ring';
    const label = document.createElement('span');
    label.className = 'cur-label';
    ring.appendChild(label);
    document.body.append(dot, ring);

    // 光标就绪 → 才隐藏系统光标
    document.documentElement.classList.add('has-cursor');

    let mx = window.innerWidth / 2;
    let my = window.innerHeight / 2;
    let rx = mx;
    let ry = my;
    let visible = false;

    window.addEventListener('mousemove', (e) => {
      mx = e.clientX;
      my = e.clientY;
      if (!visible) {
        visible = true;
        dot.classList.add('is-on');
        ring.classList.add('is-on');
      }
      // 点在链接上时，圈里显示一个小提示（可点击）
      const hot = e.target.closest(
        'a, button, .post, .video-card, .gallery-item, .chip, input, textarea, [role="button"]'
      );
      const isCard = !!(hot && hot.matches('.post, .video-card, .gallery-item'));
      ring.classList.toggle('is-hot', !!hot);
      ring.classList.toggle('is-card', isCard);
      dot.classList.toggle('is-hot', !!hot);
      label.textContent = isCard ? 'OPEN' : '';
      if (hot && hot.dataset && hot.dataset.cursorLabel) label.textContent = hot.dataset.cursorLabel;
    }, { passive: true });

    document.addEventListener('mouseleave', () => {
      visible = false;
      dot.classList.remove('is-on');
      ring.classList.remove('is-on');
    });

    // 按下时收一下，手感更实
    window.addEventListener('mousedown', () => ring.classList.add('is-down'), { passive: true });
    window.addEventListener('mouseup', () => ring.classList.remove('is-down'), { passive: true });

    // 圈的跟随用阻尼（lerp），点则完全贴住指针
    (function loop() {
      rx += (mx - rx) * 0.18;
      ry += (my - ry) * 0.18;
      dot.style.transform = `translate3d(${mx}px, ${my}px, 0) translate(-50%, -50%)`;
      ring.style.transform = `translate3d(${rx}px, ${ry}px, 0) translate(-50%, -50%)`;
      requestAnimationFrame(loop);
    })();
  }
</script>

</body>
</html>
