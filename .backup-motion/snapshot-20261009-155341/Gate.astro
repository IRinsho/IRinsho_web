---
/* =========================================================
 *  首屏舞台（Gate）—— 各内页共用的一套开场效果
 *  ---------------------------------------------------------
 *  和首页那套是同一份 CSS（.gate / .gate-* 都在 style.css 里）：
 *    全屏背景 + 压暗层 + 漂浮粒子 + 鼠标视差 + 滚动推近 + 顶部进度轨
 *
 *  用法（放在页面最前面、Base 的默认插槽里）：
 *    <Gate eyebrow="GALLERY / 02" title="相册" sub="随手拍下来的光。" />
 *    <Gate … image="media/images/xxx.jpg" />   想换背景就传 image
 * ======================================================= */
import { asset } from '../lib/url.js';

const {
  eyebrow = 'CHAPTER',
  title = '',
  sub = '',
  image = 'media/images/home-hero.jpg',   // 默认用首页那张主视觉
  no = ''                                  // 右下角的编号，可选
} = Astro.props;
---

<section class="gate gate--page" data-gate style={`--hero:url(${asset(image)})`}>
  <div class="gate-bg" aria-hidden="true">
    <span class="gate-layer gate-hero"></span>
    <span class="gate-veil"></span>
  </div>

  {/* 两层结构是**故意的**：
      .gate-particles 只负责鼠标视差（transform），
      .gate-dust 只负责滚动位移（translate）和入场漂移（animation）。
      合成到一个元素上的话，"入场动画"和"滚动位移"会抢同一个属性 ——
      这也是首页首屏以前一进去就"啪"地全出现的原因之一。 */}
  <div class="gate-particles" aria-hidden="true">
    <div class="gate-dust">
      {[...Array(8)].map((_, i) => (
        <i
          style={`left:${(i * 12.3 + 5).toFixed(1)}%;--dx:${(i % 2 ? -1 : 1) * (10 + i * 3)}px;--dy:${52 + (i % 4) * 10}vh;--dur:${20 + (i % 5) * 3}s;--delay:${(i * 1.9).toFixed(1)}s`}
        />
      ))}
    </div>
  </div>

  <div class="gate-inner">
    <p class="gate-kicker">{eyebrow}</p>
    <h1 class="gate-title">{title}</h1>
    {sub && <p class="gate-sub">{sub}</p>}
    <span class="gate-scroll" aria-hidden="true"><i></i></span>
    {no && <span class="gate-no" aria-hidden="true">{no}</span>}
  </div>
</section>

<div class="gate-rail" data-gate-rail aria-hidden="true"><i></i></div>

<script>
  /* =========================================================
   *  首屏舞台：滚动位移 + 指针视差（换页可重复初始化）
   *  ---------------------------------------------------------
   *  和首页 index.astro 里那套是同一份逻辑，改动也保持一致：
   *    1. --gate-p   淡出进度（0~1）
   *       --gate-ty  换算成竖向位移（px），写在外层 .gate-dust / .gate-bg 上
   *    2. 位移只在滚动时写、并且**只写一个变量**，形态交给 CSS 的 transform：
   *       不再给同一批元素同时挂 CSS 过渡和滚动驱动动画（那是"发飘"的来源）
   *    3. 滚动位置插值（lerp）再写进去 —— 阻尼在 JS 里做，连续、可预期
   *    4. html[data-scrolling]（滚动期间关掉慢过渡）由 Base.astro 统一维护，
   *       这里不重复写一份
   * ======================================================= */
  (function () {
    const reduce = window.matchMedia &&
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let sraf = 0;         // 滚动插值的持续循环
    let ptrRaf = 0;       // 指针事件的节流
    let idleTimer = 0;    // 开场中断标记的计时器

    const ptr = { x: 0, y: 0, cx: 0, cy: 0 };
    const move = { p: 0, cur: 0 };

    function bind() {
      const gate = document.querySelector('[data-gate]');
      if (!gate) return;

      /* ⚠ 换页返回时这段脚本会再跑一遍。
         元素没换（例如首页 → 首页）就只把变量对回当前滚动位置，
         绝不再挂一遍监听，也不要调用下面那两个闭包函数（它们在
         上一次 bind 的作用域里，这里有引用不到的风险）。 */
      if (gate.dataset.gateBound === '1') {
        const h = gate.offsetHeight || 1;
        const p = Math.min(1, Math.max(0, window.scrollY / (h * 0.85)));
        gate.style.setProperty('--gate-p', p.toFixed(4));
        gate.style.setProperty('--gate-ty', (-p * 46).toFixed(2) + 'px');
        gate.style.setProperty('--gate-ty-dust', (-p * 96).toFixed(2) + 'px');
        return;
      }
      gate.dataset.gateBound = '1';

      if (reduce) {
        gate.style.setProperty('--gate-p', '0');
        gate.style.setProperty('--gate-ty', '0px');
        gate.style.setProperty('--gate-ty-dust', '0px');
        return;
      }

      /* ---------- ① 滚动 ---------- */
      const DAMP = 0.16;     // 插值系数：越大越跟手，越小越"飘"

      function update() {
        const h = gate.offsetHeight || 1;
        move.p = Math.min(1, Math.max(0, window.scrollY / (h * 0.85)));
      }

      function tail() {
        const d = move.p - move.cur;
        if (Math.abs(d) < 0.0015) {
          move.cur = move.p;
          sraf = 0;
        } else {
          move.cur += d * DAMP;
          sraf = requestAnimationFrame(tail);
        }
        gate.style.setProperty('--gate-p', move.cur.toFixed(4));
        writeTy();
      }

      // 竖向位移：背景和粒子各自一个变量，CSS 里再乘不同系数（分层）
      function writeTy() {
        gate.style.setProperty('--gate-ty', (-move.cur * 46).toFixed(2) + 'px');
        gate.style.setProperty('--gate-ty-dust', (-move.cur * 96).toFixed(2) + 'px');
      }

      /* ⚠ 参数只有两种来源：事件（Event 对象）/ 初始化时显式传 'init'。
         初始化那次绝不算"滚动"，否则开场第一帧就被自己掐掉。 */
      function onScroll(init) {
        /* 见 index.astro 同一处的详细说明：
           开场是一次性 `both` 动画，从第 0 帧就占着 opacity；
           第一次真实滚动就把它**永久**结束掉（data-opened，不摘），
           data-scrolling 只是给别的规则做参考。 */
        if (init !== 'init') {
          gate.dataset.opened = '1';
          gate.dataset.scrolling = '1';
          clearTimeout(idleTimer);
          idleTimer = setTimeout(() => {
            delete gate.dataset.scrolling;
          }, 180);
        }

        update();
        if (!sraf) sraf = requestAnimationFrame(tail);
      }

      /* ---------- ② 指针视差（带阻尼，写 --mx / --my） ---------- */
      function loop() {
        ptr.cx += (ptr.x - ptr.cx) * 0.12;
        ptr.cy += (ptr.y - ptr.cy) * 0.12;
        gate.style.setProperty('--mx', ptr.cx.toFixed(4));
        gate.style.setProperty('--my', ptr.cy.toFixed(4));
        const still = Math.abs(ptr.x - ptr.cx) < 0.0006 && Math.abs(ptr.y - ptr.cy) < 0.0006;
        if (still) {
          ptr.cx = ptr.x;
          ptr.cy = ptr.y;
          ptrRaf = 0;
          return;
        }
        ptrRaf = requestAnimationFrame(loop);
      }

      window.addEventListener('pointermove', (e) => {
        const r = gate.getBoundingClientRect();
        if (r.bottom < 0 || r.top > window.innerHeight) return;   // 不在视野里就不算
        ptr.x = e.clientX / window.innerWidth - 0.5;
        ptr.y = e.clientY / window.innerHeight - 0.5;
        if (!ptrRaf) ptrRaf = requestAnimationFrame(loop);
      }, { passive: true });

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });

      update();
      move.cur = move.p;
      tail();
      onScroll('init');     // 初始化不算滚动，别把开场掐掉
    }

    document.addEventListener('astro:page-load', bind);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bind);
    } else {
      bind();
    }
  })();
</script>
